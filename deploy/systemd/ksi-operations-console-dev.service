[Unit]
Description=KSI Operations Console Tailnet development stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/KSI-Projects/KSI-Site-Intelligence-Platform/apps/dashboard
ExecStart=/usr/bin/env npm run dev
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
