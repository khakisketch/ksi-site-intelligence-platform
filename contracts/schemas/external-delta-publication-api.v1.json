        "organizationId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Organizationid",
          "type": "string"
        },
        "siteId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Siteid",
          "type": "string"
        },
        "workAreaId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Workareaid",
          "type": "string"
        },
        "sourceContractVersion": {
          "enum": [
            "external-relative-volume-calculation-report.v2",
            "external-masked-volume-calculation-identity.v3"
          ],
          "title": "Sourcecontractversion",
          "type": "string"
        },
        "sourceCalculationIdentityDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sourcecalculationidentitydigest",
          "type": "string"
        },
        "sourceNumericResultIdentityDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sourcenumericresultidentitydigest",
          "type": "string"
        },
        "sourceCoverageWitnessDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sourcecoveragewitnessdigest",
          "type": "string"
        },
        "deltaSign": {
          "const": "CURRENT_MINUS_BASELINE",
          "title": "Deltasign",
          "type": "string"
        },
        "gridRows": {
          "exclusiveMinimum": 0,
          "title": "Gridrows",
          "type": "integer"
        },
        "gridColumns": {
          "exclusiveMinimum": 0,
          "title": "Gridcolumns",
          "type": "integer"
        },
        "transform": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
