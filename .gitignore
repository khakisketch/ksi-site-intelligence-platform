# 모델 아티팩트(루트 models/ 한정 — docs/models/ 는 계보 SSOT 라 추적한다).
# 파일 자체는 tools/fetch_model.py 로 명시적으로 받는다(런타임 자동 다운로드 금지).
/models/

# 빌드 산출물·캐시 — 로컬 절대경로가 박혀 CI 를 오염시킨다(2026-07-27 CI 실패 재발 방지)
# build/·build-asan/·build-manifold3/·build-host/ 등을 전부 포괄(2026-08-03 Manifold3 HIL
# 세션 정리). edge 하위 네이티브 트리는 manifold-runtime 하나가 아니다(psdk-tap, 향후
# psdk-app) — 트리를 하나씩 열거하면 새 트리가 조용히 빠진다(2026-08-04, psdk-tap의
# build-host/ 가 실제로 추적 대상에 올라와 있던 것을 커밋 직전 발견).
edge/*/build*/
__pycache__/
*.pyc
.venv/

# HIL 세션 raw 로그 로컬 스테이징 — 커밋하지 않는다(docs/hil/RAW_LOG_CONVENTIONS.md §1·§5).
# 세션 종료 후 durable 저장소로 옮기고 SpikeEvidence.raw_log_ref 는 그 URI 를 가리킨다.
/hil_raw_logs/

# scripts/run_core_dev.py 로컬 개발 서버 durable 저장소 + 서명키 — dev 전용, 커밋하지 않는다.
/.dev-data/

# apps/dashboard (Next.js) 빌드 산출물·의존성
apps/dashboard/node_modules/
apps/dashboard/.next/
apps/dashboard/.env.local

# Manifold 3 / PSDK 개발 — ADR-KSI-009. 비밀·산출물·서드파티 실물은 커밋하지 않는다.
# 계보는 edge/third_party/PSDK_LOCK.yaml(커밋)이 SSOT, 실물은 tools/edge/fetch_psdk.py로 fetch.
/.secrets/
/dist/
edge/third_party/psdk/
**/dji_sdk_app_info.h

# 디자인 시안 생성물 — design/**/_build.py 가 SSOT 다(HTML 은 전부 그 출력).
# 채택 결과의 정본은 apps/dashboard/src/app/globals.css 의 토큰이다.
design/**/screens/
design/**/studies/
design/**/index.html

# UI 검증 스크린샷·브라우저 자동화 산출물 — 저장소 루트에 쌓이는 일회성 파일이다.
# 남길 가치가 있는 컷은 docs/ 아래 명시 경로로 옮긴다(루트 한정 규칙이라 하위
# 디렉터리의 의도적 이미지 자산은 그대로 추적된다).
/*.png
/.playwright-mcp/

# manifoldctl 머신별 설정 — IP는 DHCP로 바뀔 수 있어 저장소에 커밋하지 않는다
# (manifold.env.example 참조. 비밀은 없지만 머신별 값이라 무시 대상이 맞다 — 2026-08-04
# 병렬 감사에서 여기 없어 mf_git_is_dirty가 항상 true가 되던 결함 발견·정정, 감사 #3).
scripts/manifold/manifold.env
