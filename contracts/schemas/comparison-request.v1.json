{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/schemas/comparison-request.v1.json",
  "title": "ComparisonRequest",
  "description": "두 시점(baseline/current) processing-job을 비교해 달라는 지시(W2, ADR-KSI-016 D3). ChangeDetectionResult/VolumeChangeReport는 이미 계산된 결과를 나르고, 이 계약은 그 계산을 해 달라는 요청을 나른다 — 형태가 다르다. changeDetectionEligible/volumeChangeEligible은 요청 생성 시점에 baseline/current의 등록된 산출물을 조회해 서버가 판정한 값이다(요청 쪽이 스스로 주장하지 않는다). zones는 site AOI를 가리키는 참조가 아니라 그 순간 확정한 값 자체다 — 나중에 현장 경계가 바뀌어도 이미 만든 요청은 그대로 유지되는 불변 스냅샷이다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "missionId",
    "siteId",
    "baselineJobId",
    "currentJobId",
    "changeDetectionEligible",
    "volumeChangeEligible",
    "status",
    "requestedAt",
    "requestedBy",
    "updatedAt",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "description": "이 요청의 고유 식별자. 워커가 제출하는 changeDetectionId/volumeChangeId 가 이 값과 같다(같은 요청의 재시도가 결과 store 의 멱등 로직에서 자연스럽게 중복 처리되게 한다)."
    },
    "missionId": {
      "type": "string",
      "minLength": 1,
      "description": "이 비교 결과가 귀속될 임무 — currentJobId 가 속한 임무와 같아야 한다."
    },
    "siteId": {
      "type": "string",
      "minLength": 1,
      "description": "baseline/current 두 작업이 공유하는 현장. 서로 다른 현장의 작업은 비교 요청 자체가 거부된다."
    },
    "baselineJobId": {
      "type": "string",
      "minLength": 1
    },
    "currentJobId": {
      "type": "string",
      "minLength": 1
    },
    "pointCloudBaseline": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "pointCloudCurrent": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "changeDetectionEligible": {
      "type": "boolean",
      "description": "baseline/current 양쪽에 point_cloud 산출물이 등록돼 있어 점군 C2C 변화탐지를 시도할 수 있는가."
    },
    "changeDetectionIneligibleReason": {
      "type": [
        "string",
        "null"
      ],
      "description": "false 일 때 왜인지 — '변화 없음'과 '비교 불가'를 화면이 구분해 보여줄 수 있게 한다."
    },
    "dsmBaseline": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "dsmCurrent": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "volumeChangeEligible": {
      "type": "boolean",
      "description": "baseline/current 양쪽에 dsm 산출물이 등록돼 있고 zones 가 확정돼 있어 체적 변화를 시도할 수 있는가."
    },
    "volumeChangeIneligibleReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "zones": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "description": "zoneId -> GeoJSON Polygon. site AOI 를 초기값으로 보여주되 사용자가 확인·수정한 뒤 명시적으로 확정한 값의 스냅샷(대표자 확정, 2026-08-10) — site.aoi 를 참조하지 않는다.",
          "additionalProperties": {
            "type": "object"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "zoneCrs": {
      "type": [
        "string",
        "null"
      ],
      "description": "zones 폴리곤의 좌표계(보통 EPSG:4326). zones 가 null 이면 이 값도 null."
    },
    "policy": {
      "$ref": "#/$defs/comparisonPolicy"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "detail": {
      "type": [
        "string",
        "null"
      ],
      "description": "종료 상태에서만 채워진다 — FAILED 로 끝난 이유."
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "artifactId"
      ],
      "description": "산출물 참조. artifactId 는 처리 작업 단위로만 고유하므로(processing_jobs.py) jobId 와 짝으로만 해석 가능하다.",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyVersion",
        "distanceThresholdM",
        "volumeThresholdM",
        "revisitRatioThreshold"
      ],
      "description": "이 요청이 실제로 쓸/쓴 기준값의 불변 스냅샷. zones 와 같은 이유로 참조가 아니라 값이다 — 시스템 기준값이 바뀌어도 이미 만들어진 요청은 자기 스냅샷으로만 계산된다. 정본은 ksi_event_contracts.comparison_policy.",
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "distanceThresholdM": {
          "type": "number",
          "minimum": 0
        },
        "volumeThresholdM": {
          "type": "number",
          "minimum": 0
        },
        "revisitRatioThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
