{
  "source": {
    "repo": "ksi-scout",
    "commit": "42ccc0db",
    "file": "ksi_scout/geo/projection.py"
  },
  "extraction": {
    "script": "tools/vector-extraction/capture_scout_projection.py",
    "runtime": {
      "language": "python",
      "version": "3.12.13",
      "runner": "scratchpad venv (uv venv --python 3.12) — deps: numpy 2.5.1, pydantic 2.13.4, shapely 2.1.2. packages/test-vectors/pyproject.toml·uv.lock 미변경(별도 임시 venv)."
    }
  },
  "tolerance": {
    "abs": 1e-06,
    "rel": 1e-09,
    "rationale": "이 벡터는 회전행렬 3개 합성(Rz_cw·Rx·R0·Rroll) 핀홀 투영이다. 필드별 근거: east_m/north_m/error_radius_m(거리, m) → abs 1e-4 m (references/repos/ksi-scout의 round-trip 테스트가 <0.01~1e-3m 편차를 통과 기준으로 삼는 것과 동일 스케일); lat/lon(도, WGS84) → abs 1e-9 deg (경위도 변환은 상수 나눗셈 1건뿐이라 부동소수 오차만 남고, 1e-9도≈0.0001m 수준이라 위치 정밀도를 해치지 않음); geo_confidence(무단위 [0,1] 스칼라, 여러 factor의 product) → abs 1e-9 (동일 정밀도의 double 연산 반복이라 rel 대신 절대오차가 적절). 최상위 abs/rel 은 기본값(가장 보수적인 confidence 기준)이고, 필드별 override 는 tolerance.by_field 를 본다.",
    "by_field": {
      "east_m": {
        "abs": 0.0001,
        "rel": 0
      },
      "north_m": {
        "abs": 0.0001,
        "rel": 0
      },
      "error_radius_m": {
        "abs": 0.0001,
        "rel": 0
      },
      "position_error_radius_m": {
        "abs": 0.0001,
        "rel": 0
      },
      "lat": {
        "abs": 1e-09,
        "rel": 0
      },
      "lon": {
        "abs": 1e-09,
        "rel": 0
      },
      "geo_confidence": {
        "abs": 1e-09,
        "rel": 0
      }
    }
  },
