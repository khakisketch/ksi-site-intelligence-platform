# KSI Core / 처리 워커 운영 환경변수 예제
#
# 이 파일을 `.env` 로 복사해 값을 채운 뒤 `docker compose --env-file` 로 넘긴다.
# **`.env` 자체는 커밋하지 않는다**(리포지토리 .gitignore 가 막는다).
#
# 값의 근거는 코드가 SSOT 다 — Core 는 services/core/src/ksi_core/production.py,
# 워커는 services/processing-controller/src/ksi_processing_controller/runner.py.
# 아래 "필수"는 그 코드가 없으면 RuntimeError 로 즉시 기동을 거부하는 것들이다
# (조용한 기본값을 두지 않는 것이 의도된 설계다 — production.py 모듈 docstring).
#
# 절차 전체는 docs/ops/DEPLOYMENT.md 참조.

# ─────────────────────────────────────────────────────────────────────────────
# Core — 필수 (하나라도 없으면 기동 거부)
# ─────────────────────────────────────────────────────────────────────────────

# 원장(append-only journal)이 사는 디렉터리. **영속 볼륨이어야 한다** —
# 컨테이너와 함께 사라지면 현장·임무·산출물 이력이 전부 사라진다.
KSI_CORE_DATA_DIR=/var/lib/ksi/data

# Mission Contract 서명키 디렉터리. `keys.json` 매니페스트 + 키 파일이 여기 있어야 한다.
# **Core 는 키를 새로 만들지 않는다** — 이미 있는 것만 읽는다. 컨테이너 재생성마다 새 키가
# 생기면 이미 현장에 발급된 계약이 전부 검증 실패하기 때문이다(서버가 죽어도 로컬에서
# 유효한 계약은 유효해야 한다는 제품 전제). 반드시 컨테이너 밖 영속 볼륨에 둔다.
# 최초 생성·회전 절차: docs/security/SIGNING_KEY_LIFECYCLE.md
KSI_CORE_SIGNING_KEYS_DIR=/var/lib/ksi/signing-keys

# 증거·3D 산출물 객체 저장소(S3 호환). MinIO 면 그 엔드포인트, AWS S3 면 리전 엔드포인트.
# **선택이 아니다** — 이게 없으면 증거·3D 파이프라인 전체가 조용히 404 인 서버가 된다.
KSI_CORE_S3_ENDPOINT=http://minio:9000
# presigned URL에 들어갈 현장 접근 endpoint. 로컬 compose에서는 localhost, 외부 VM은
# Caddy가 TLS로 여는 objects.<domain>을 사용한다. 내부 endpoint와 분리해야 브라우저가
# Docker DNS 이름(minio)을 받지 않는다.
KSI_CORE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
KSI_CORE_S3_BUCKET=ksi-evidence

# 접근 토큰 목록 — **원문이 아니라 sha256 digest 만** 싣는다(소문자 64자리 hex).
# 서버 메모리·로그·환경변수 어디에도 원문 토큰이 남지 않는 것이 이 규약의 목적이다.
#
# digest 만드는 법:
#   TOKEN=$(openssl rand -hex 32)                            # 이 원문을 사용자에게 전달한다
#   printf '%s' "$TOKEN" | sha256sum | awk '{print $1}'      # 이 digest 를 아래 JSON 에 넣는다
#   (awk 를 빼면 sha256sum 이 붙이는 뒤쪽 "  -" 까지 들어가 기동이 거부된다)
#
# 필드: tokenSha256(필수) · principalId(필수) · kind(필수) · organizationId(필수 운용값)
#       role(OPERATOR 일 때 필수) · deviceId(GATEWAY_DEVICE/EDGE_DEVICE 일 때 필수)
#       status(ACTIVE|REVOKED, 기본 ACTIVE)
#       notAfter(ISO 8601 tz-aware, 없으면 만료 없음)
# kind: OPERATOR | GATEWAY_DEVICE | EDGE_DEVICE | PROCESSING_WORKER
# role: ADMIN | FIELD_OPERATOR | VIEWER
#
# 회전 중에는 같은 principalId 로 이전 digest(notAfter 로 유예기간 종료)와
# 새 digest(notAfter 없음)를 함께 배포한다 — docs/security/AUTH_TOKEN_ROTATION.md
KSI_CORE_PRINCIPAL_TOKENS_JSON=[{"tokenSha256":"<admin token 64자리 hex>","principalId":"admin-1","organizationId":"org-pilot-1","kind":"OPERATOR","role":"ADMIN"},{"tokenSha256":"<gateway token 64자리 hex>","principalId":"gateway-rc-1","organizationId":"org-pilot-1","kind":"GATEWAY_DEVICE","deviceId":"rc-plus-2-1"},{"tokenSha256":"<edge token 64자리 hex>","principalId":"edge-manifold-1","organizationId":"org-pilot-1","kind":"EDGE_DEVICE","deviceId":"manifold-1"},{"tokenSha256":"<worker token 64자리 hex>","principalId":"worker-1","organizationId":"org-pilot-1","kind":"PROCESSING_WORKER"}]

# Edge activation/evidence attestation 공개키 manifest. 개인키는 Manifold 장비 밖으로
# 나오지 않는다. 최초 준비는 `cp device-attestation-keys.example.json
# device-attestation-keys.json` 후 장비 공개키 항목을 추가한다.
KSI_CORE_DEVICE_ATTESTATION_KEYS_FILE=/var/lib/ksi/device-attestation-keys.json

# 객체 저장소 자격증명 — boto3 기본 체인으로 들어간다(코드가 따로 읽지 않는다).
# 클라우드에서 IAM role 을 쓰면 이 둘을 비우고 role 을 붙인다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 워커 — 선택 (이 compose 는 core·worker 가 같은 .env 를 공유하므로 여기 둔다)
# ─────────────────────────────────────────────────────────────────────────────

# 정표고(해발) 설계도면을 받으려면 국가 지오이드 격자를 가리켜야 한다.
# **읽는 쪽은 워커다** — Core 는 이 변수를 읽지 않는다(production.py 에 참조 0건).
# Core 는 "이을 수 있는 종류인가"만 순수 표로 답하고, 격자를 실제로 읽어 변환하는
# 것은 워커다(design_conformance_requests.py 모듈 docstring). Core 가 자기 환경을
# 보고 답하면 워커 능력에 대한 거짓말이 된다.
# 미설정이면 정표고 설계면은 계산되지 않고 **거부된다**(숫자를 지어내지 않는다).
# 격자 없이 변환하면 한국에서 20~30m 가 조용히 틀리기 때문이다.
# 취득·검증 절차: docs/geo/GEOID_ACQUISITION.md (파일은 저장소에 함께 있다)
KSI_GEOID_GRID=/app/data/geoid/KNGeoid24.tif

# ─────────────────────────────────────────────────────────────────────────────
# Core — 선택
# ─────────────────────────────────────────────────────────────────────────────

# 로그 레벨(기본 INFO)
KSI_CORE_LOG_LEVEL=INFO

# OpenAPI 문서 노출 여부. 운영에서는 켜지 않는 것이 기본이다.
KSI_CORE_EXPOSE_DOCS=0

# WorkOrder 중심 Acquisition coordinator. 장애 rollback 때 false로 내리면 신규
# coordination API만 닫히며 기존 Mission/KMZ와 수동 ingest 복구 경로는 유지된다.
KSI_CORE_ACQUISITION_COORDINATION_ENABLED=true

# 새 Mission 발급 시 Acquisition Profile + 유효 heartbeat + capability 증거를 강제한다.
# RC 기본형 HIL과 기존 Site profile migration 전에는 반드시 false다. 이 flag를 꺼도
# 이미 활성화된 Mission Contract를 네트워크 상태만으로 취소하지 않는다.
KSI_CORE_ACQUISITION_ISSUE_GATE_ENABLED=false

# 새 처리작업을 versioned Core 처리 프로필로 발행한다. 장애 rollback 때 false로
# 내리면 기존 작업·산출물 조회는 유지하고 신규 프로필 작업 발행만 닫힌다.
KSI_CORE_PROCESSING_PROFILE_ISSUANCE_ENABLED=true

# LandXML 원본 등록·정규화 입구. 정규화 워커와 원본/파생 스토리지 경로를 함께
# 검증한 환경에서만 true로 올린다. false여도 기존 GeoTIFF 경로와 과거 자산 조회는 유지된다.
KSI_CORE_LANDXML_INGRESS_ENABLED=false

# 독립 측량 checkpoint CSV 등록·worker 검증 발행. 기본 false이며, 켜도 결과는
# 운영관리용 상대 물량의 근거일 뿐 측량급/정산 정확도를 주장하지 않는다.
# false여도 이미 기록된 검증 결과의 조회와 기존 비교는 유지된다.
KSI_CORE_CHECKPOINT_VALIDATION_ENABLED=false

# 현장 KSI AI. 기본 OFF이며 아래 값은 true일 때 모두 필요하다. API key 원문은
# .env에 넣지 않고 읽기 전용 secret file 경로만 넘긴다. 현장별 aiEgressAllowed가
# false이면 이 전역 flag가 켜져 있어도 외부 호출은 거부된다.
KSI_COPILOT_ENABLED=false
KSI_COPILOT_BASE_URL=https://ai-provider.example.invalid
KSI_COPILOT_MODEL=approved-model-id
KSI_COPILOT_API_KEY_FILE=/run/secrets/copilot-api-key
KSI_COPILOT_REQUEST_TIMEOUT_SECONDS=30
KSI_COPILOT_PLANNER_VERSION=site-copilot-v1
KSI_COPILOT_PROVIDER_NAME=openai-compatible

# Mission Contract writer는 dual-reader migration 동안 1.2가 기본이다. HIL/rollback
# 검증 뒤 1.3으로 올릴 때만 issuerId를 함께 설정한다.
KSI_CORE_MISSION_CONTRACT_WRITER_VERSION=1.2
# KSI_CORE_MISSION_CONTRACT_ISSUER_ID=ksi-core-prod-1

# Edge dispatch 입력. 비어 있거나 미설정이면 dispatch는 204이며, 서버가 장비 형상·
# 위험 기본값을 추측하지 않는다. 검증된 pack/profile 전문이 준비된 배포에서만 채운다.
# KSI_CORE_RISK_POLICY_PACKS_JSON=[]
# KSI_CORE_EDGE_RUNTIME_PROFILES_JSON=[]

# 원장 세그먼트 크기·edge-sync 스냅샷 주기 — 기본값이 있다. 성능 문제가 실제로
# 관측되기 전에는 건드리지 않는다.
# KSI_CORE_JOURNAL_SEGMENT_BYTES=
# KSI_CORE_EDGE_SYNC_SNAPSHOT_EVERY=

# ─────────────────────────────────────────────────────────────────────────────
# 처리 워커 — 재구성(ODM)·비교·설계 대비 잔량을 실제로 계산하는 프로세스
# ─────────────────────────────────────────────────────────────────────────────

KSI_WORKER_CORE_BASE_URL=http://core:8000

# 위 PRINCIPAL_TOKENS_JSON 에 PROCESSING_WORKER 로 등록한 토큰의 **원문**.
# (Core 는 digest 를 갖고, 워커는 원문을 갖는다.)
KSI_WORKER_CORE_TOKEN=

KSI_WORKER_NODEODM_BASE_URL=http://nodeodm:3000

# 워커가 사진을 내려받아 재구성하는 작업 디렉터리. 큰 용량이 필요하고,
# 중단 후 재개를 위해 영속 볼륨을 권장한다.
KSI_WORKER_WORK_DIR=/var/lib/ksi/worker

# 폴링·하트비트 주기(초) — 기본값이 있다.
# KSI_WORKER_POLL_INTERVAL_SECONDS=
# KSI_WORKER_HEARTBEAT_INTERVAL_SECONDS=

KSI_WORKER_LOG_LEVEL=INFO
KSI_WORKER_LOG_FORMAT=json

# (선택) 동적 객체(사람·차량) 마스킹 — PRD §15.2 ④. **미설정이면(기본) 마스킹
# 없이 지금까지와 동일하게 동작한다** — torch·모델 가중치가 모든 배포에 있는
# 게 아니라서([dfine] extra, base 의존이 아님) 기본은 반드시 꺼짐이어야 한다.
# 값을 주면 그 디렉터리에서 D-FINE-S 탐지기를 로드해 재구성 제출마다 사람·
# 차량 영역의 마스크를 함께 싣는다(NodeODM 실물 대상 검증됨 — odm_masking.py
# 모듈 docstring).
#
# 받는 법:
#   uv run python tools/fetch_model.py ksi-person-detector-dfine-s-coco
#   → models/dfine-small-coco/<revision>/ 를 이 변수에 준다.
#
# **설정했는데 로드가 실패하면(경로 없음·digest 불일치·[dfine] extra 미설치 등)
# 워커가 기동 자체를 거부한다(fail-closed)** — "마스킹을 켰다고 믿고 있는데
# 실제로는 한 번도 지운 적 없는 상태"를 조용히 허용하지 않는다. 원치 않으면
# 이 변수를 비운다.
# KSI_WORKER_DYNAMIC_OBJECT_MODEL_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (compose 로 함께 띄울 때만)
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 외부 VM profile (compose.vm.yaml을 함께 사용할 때 필수)
# ─────────────────────────────────────────────────────────────────────────────

# 실제 승인된 도메인만 사용한다. 예: ksi.example.com이면 app.ksi.example.com,
# api.ksi.example.com, objects.ksi.example.com 세 DNS A/AAAA record가 같은 VM을 향한다.
KSI_CLOUD_DOMAIN=example.invalid
KSI_CLOUD_ACME_EMAIL=ops@example.invalid

# 사람 OIDC JWT를 Core가 검증할 vendor-neutral 입력. access token에
# ksi_principal_id, ksi_organization_id, ksi_role claim이 있어야 한다.
KSI_CORE_HUMAN_AUTH_MODE=OIDC
KSI_CORE_OIDC_ISSUER=https://id.example.invalid
KSI_CORE_OIDC_AUDIENCE=ksi-core
KSI_CORE_OIDC_JWKS_URL=https://id.example.invalid/.well-known/jwks.json
KSI_CORE_OIDC_ALLOWED_ALGORITHMS=RS256
KSI_CORE_OIDC_JWKS_TTL_SECONDS=300

# Dashboard Auth.js confidential client. secret 원문은 이 파일에 넣지 않고
# deploy/secrets/oidc-client.secret file mount로만 공급한다.
KSI_DASHBOARD_DEPLOYMENT_PROFILE=EXTERNAL_VM
KSI_DASHBOARD_HUMAN_AUTH_MODE=OIDC
KSI_DASHBOARD_OIDC_ISSUER=https://id.example.invalid
KSI_DASHBOARD_OIDC_CLIENT_ID=ksi-operations-console
