{
  "source": {
    "repo": "ksi-platform",
    "commit": "030ebd5a7ff0762e729b29fe7710f8f3a30e8604",
    "file": "ksi-safety/src/lib/proximity-distance.ts"
  },
  "extraction": {
    "script": "tools/vector-extraction/capture_platform_proximity.mts",
    "runtime": {
      "language": "node",
      "version": "v22.22.3",
      "runner": "npx -y tsx (tsx v4.23.1\nnode v22.22.3) — 네트워크 fetch 1회, node_modules 불필요. proximity-distance.ts→proximity.ts→safety-zone.ts 체인은 순수 TS/JS(외부 npm 런타임 의존 없음). package.json/node_modules 미변경(스크래치패드 실행)."
    }
  },
  "tolerance": {
    "abs": 1e-06,
    "rel": 1e-09,
    "rationale": "이 벡터는 삼각함수 기반 카메라 기저(cameraBasis: sin/cos/atan/normalize)로 만든 핀홀 광선-평면 교차다. ENU 결과([east_m, north_m], m) → abs 1e-4 m (부동소수 반복 연산이지만 단일 스케일 나눗셈이라 스케일 원리 반경 오차는 이 이하); distanceM/distanceToZoneM/rAlertM/rWarnM(m) → abs 1e-2 m (원 구현이 Math.round(x*100)/100 으로 이미 소수 둘째자리까지 반올림해 반환하므로, 그 반올림 정밀도가 비교 기준); tier/reason/severity/basis 등 열거형 문자열 → 정확히 일치(수치 tolerance 비적용, 문자열 동등비교). 최상위 abs/rel 은 ENU 미터 계열 기본값.",
    "by_field": {
      "east_m": {
        "abs": 0.0001,
        "rel": 0
      },
      "north_m": {
        "abs": 0.0001,
        "rel": 0
      },
      "distanceM": {
        "abs": 0.01,
        "rel": 0
      },
      "distanceToZoneM": {
        "abs": 0.01,
        "rel": 0
      },
      "rAlertM": {
        "abs": 0.0001,
        "rel": 0
      },
      "rWarnM": {
        "abs": 0.0001,
        "rel": 0
      }
    }
  },
