{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.local/contracts/external-relative-volume-calculation.v2.json",
  "title": "KSI external relative-volume calculation V2",
  "description": "Sealed numeric calculation, execution attempt, report, or typed failure. AP suitability records remain a separate contract family.",
  "oneOf": [
    { "$ref": "#/$defs/numericResult" },
    { "$ref": "#/$defs/report" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 255 },
    "utc": { "type": "string", "pattern": "Z$|\\+00:00$" },
    "mask": {
      "type": "string",
      "minLength": 4,
      "maxLength": 2000000,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "resourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxStreamedBytes", "maxTiffDirectories", "maxTiffEntries", "maxPixels", "maxBands", "maxBlocks", "maxDecompressedBytes", "maxSampleBytes", "maxGeometryVertices", "maxCpuSeconds", "maxMemoryBytes", "maxWorkspaceBytes", "maxOutputBytes", "maxTenantConcurrency", "maxQueueDepth", "maxDeadlineSeconds", "leaseDurationSeconds", "maxRetryAttempts", "resourceEnvelopeDigest"],
      "properties": {
        "maxInputBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "maxStreamedBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "maxTiffDirectories": { "type": "integer", "exclusiveMinimum": 0 },
        "maxTiffEntries": { "type": "integer", "exclusiveMinimum": 0 },
        "maxPixels": { "type": "integer", "exclusiveMinimum": 0 },
        "maxBands": { "type": "integer", "exclusiveMinimum": 0 },
        "maxBlocks": { "type": "integer", "exclusiveMinimum": 0 },
        "maxDecompressedBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "maxSampleBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "maxGeometryVertices": { "type": "integer", "exclusiveMinimum": 0 },
        "maxCpuSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxMemoryBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "maxWorkspaceBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "maxOutputBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "maxTenantConcurrency": { "type": "integer", "exclusiveMinimum": 0 },
        "maxQueueDepth": { "type": "integer", "exclusiveMinimum": 0 },
        "maxDeadlineSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "leaseDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxRetryAttempts": { "type": "integer", "exclusiveMinimum": 0 },
        "resourceEnvelopeDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "rows", "columns", "rowOffset", "columnOffset", "selectedMaskB64", "commonValidMaskB64", "unavailableMaskB64", "thresholdExcludedMaskB64", "selectedCellCount", "commonValidCellCount", "unavailableCellCount", "thresholdExcludedCellCount", "cellAreaM2", "selectedAreaM2", "commonValidAreaM2", "bounds", "coverageWitnessDigest"],
      "properties": {
        "contractVersion": { "const": "external-relative-volume-coverage-witness.v2" },
        "rows": { "type": "integer", "exclusiveMinimum": 0 },
        "columns": { "type": "integer", "exclusiveMinimum": 0 },
        "rowOffset": { "type": "integer" },
        "columnOffset": { "type": "integer" },
        "selectedMaskB64": { "$ref": "#/$defs/mask" },
        "commonValidMaskB64": { "$ref": "#/$defs/mask" },
        "unavailableMaskB64": { "$ref": "#/$defs/mask" },
        "thresholdExcludedMaskB64": { "$ref": "#/$defs/mask" },
        "selectedCellCount": { "type": "integer", "minimum": 0 },
        "commonValidCellCount": { "type": "integer", "minimum": 0 },
        "unavailableCellCount": { "type": "integer", "minimum": 0 },
        "thresholdExcludedCellCount": { "const": 0 },
        "cellAreaM2": { "type": "number", "exclusiveMinimum": 0 },
        "selectedAreaM2": { "type": "number", "minimum": 0 },
        "commonValidAreaM2": { "type": "number", "minimum": 0 },
        "bounds": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}], "items": false },
        "coverageWitnessDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutM3", "fillM3", "netM3", "thresholdM", "uncertaintyM3"],
      "properties": {
        "cutM3": { "type": "number", "minimum": 0 },
        "fillM3": { "type": "number", "minimum": 0 },
        "netM3": { "type": "number" },
        "thresholdM": { "const": 0.0 },
        "uncertaintyM3": { "const": null }
      }
    },
    "numericResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "calculationIdentityDigest", "profileDigest", "metrics", "coverage", "numericResultIdentityDigest"],
      "properties": {
        "contractVersion": { "const": "external-relative-volume-numeric-result.v2" },
        "calculationIdentityDigest": { "$ref": "#/$defs/digest" },
        "profileDigest": { "$ref": "#/$defs/digest" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "numericResultIdentityDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "authorizationId", "organizationId", "calculationIdentityDigest", "admissionDigest", "resourceEnvelope", "resourceEnvelopeDigest", "authorizedAt", "executionAuthorizationDigest"],
      "properties": {
        "contractVersion": { "const": "external-relative-volume-execution-authorization.v2" },
        "authorizationId": { "$ref": "#/$defs/text" },
        "organizationId": { "$ref": "#/$defs/text" },
        "calculationIdentityDigest": { "$ref": "#/$defs/digest" },
        "admissionDigest": { "$ref": "#/$defs/digest" },
        "resourceEnvelope": { "$ref": "#/$defs/resourceEnvelope" },
        "resourceEnvelopeDigest": { "$ref": "#/$defs/digest" },
        "authorizedAt": { "$ref": "#/$defs/utc" },
        "executionAuthorizationDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "attemptId", "authorization", "authorizationDigest", "workerInstanceId", "leaseAcquisitionId", "leaseGeneration", "issuedAt", "leaseExpiresAt", "executionAttemptDigest"],
      "properties": {
        "contractVersion": { "const": "external-relative-volume-execution-attempt.v2" },
        "attemptId": { "$ref": "#/$defs/text" },
        "authorization": { "$ref": "#/$defs/authorization" },
        "authorizationDigest": { "$ref": "#/$defs/digest" },
        "workerInstanceId": { "$ref": "#/$defs/text" },
        "leaseAcquisitionId": { "$ref": "#/$defs/text" },
        "leaseGeneration": { "type": "integer", "minimum": 1 },
        "issuedAt": { "$ref": "#/$defs/utc" },
        "leaseExpiresAt": { "$ref": "#/$defs/utc" },
        "executionAttemptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "reportId", "attempt", "attemptDigest", "numericResult", "numericResultIdentityDigest", "computedAt", "reportedAt", "reportDigest"],
      "properties": {
        "contractVersion": { "const": "external-relative-volume-calculation-report.v2" },
        "reportId": { "$ref": "#/$defs/text" },
        "attempt": { "$ref": "#/$defs/attempt" },
        "attemptDigest": { "$ref": "#/$defs/digest" },
        "numericResult": { "$ref": "#/$defs/numericResult" },
        "numericResultIdentityDigest": { "$ref": "#/$defs/digest" },
        "computedAt": { "$ref": "#/$defs/utc" },
        "reportedAt": { "$ref": "#/$defs/utc" },
        "reportDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "failureId", "attempt", "attemptDigest", "reasonCode", "failedAt", "failureDigest"],
      "properties": {
        "contractVersion": { "const": "external-relative-volume-calculation-failure.v2" },
        "failureId": { "$ref": "#/$defs/text" },
        "attempt": { "$ref": "#/$defs/attempt" },
        "attemptDigest": { "$ref": "#/$defs/digest" },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
        "failedAt": { "$ref": "#/$defs/utc" },
        "failureDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
