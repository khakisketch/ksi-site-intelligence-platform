        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "sourceReportDigest",
        "inspectorBuildDigest",
        "observedCrsIdentifier",
        "observedCrsDigest",
        "transform",
        "footprintWkt",
        "footprintDigest",
        "width",
        "height"
      ],
      "title": "SpatialAssetInspectedRasterFactsV1",
      "type": "object"
    },
    "SpatialAssetInspectionV1": {
      "additionalProperties": false,
      "description": "Compact inspection status, never an analysis or accuracy conclusion.",
      "properties": {
        "state": {
          "maxLength": 64,
          "minLength": 1,
          "title": "State",
          "type": "string"
        },
        "reportDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reportdigest"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "MEASURED",
                "NOT_APPLICABLE",
                "REJECTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "inspectorBuildDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspectorbuilddigest"
        },
        "raster": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpatialAssetInspectedRasterFactsV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "state"
      ],
      "title": "SpatialAssetInspectionV1",
      "type": "object"
    },
    "SpatialAssetLifecycleStateV1": {
      "enum": [
        "UNSEALED",
        "SEALED",
        "SUPERSEDED"
      ],
      "title": "SpatialAssetLifecycleStateV1",
      "type": "string"
    },
    "SpatialAssetObservedFactsV1": {
      "additionalProperties": false,
      "description": "Core-sealed byte observations; storage paths and capabilities are excluded.",
      "properties": {
        "factClass": {
          "const": "OBSERVED",
          "default": "OBSERVED",
          "title": "Factclass",
          "type": "string"
        },
        "manifestDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifestdigest",
          "type": "string"
        },
        "observedAt": {
          "format": "date-time",
          "title": "Observedat",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "sizeBytes": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Sizebytes",
          "type": "integer"
        },
        "contentType": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contenttype",
          "type": "string"
        }
      },
      "required": [
        "manifestDigest",
        "observedAt",
        "sha256",
        "sizeBytes",
        "contentType"
      ],
      "title": "SpatialAssetObservedFactsV1",
      "type": "object"
    },
    "SpatialAssetObservedVerticalReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "basis": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "basis"
      ],
      "title": "SpatialAssetObservedVerticalReferenceV1",
      "type": "object"
    },
    "SpatialAssetPixelResolutionV1": {
      "additionalProperties": false,
      "description": "Native pixel size derived from the inspected affine transform.\n\nResolution is the axis norm (``hypot(a, d)`` / ``hypot(b, e)`` for GDAL\norder ``(a, b, c, d, e, f)``), never the naive ``abs(a)``/``abs(e)`` which\nunderstates rotated rasters. ``transform_is_rotated`` is set exactly when\nthe inspected shear terms are nonzero. Values are expressed in\n``horizontal_units`` of the enclosing raster detail; when units are\nunknown the numbers still describe pixel geometry, not meters.",
      "properties": {
        "factClass": {
          "const": "INSPECTED",
          "default": "INSPECTED",
          "title": "Factclass",
          "type": "string"
        },
        "sourceReportDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sourcereportdigest",
          "type": "string"
        },
        "inspectorBuildDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Inspectorbuilddigest",
          "type": "string"
        },
        "resolutionX": {
          "exclusiveMinimum": 0,
          "title": "Resolutionx",
          "type": "number"
        },
        "resolutionY": {
          "exclusiveMinimum": 0,
          "title": "Resolutiony",
          "type": "number"
        },
        "transformIsRotated": {
          "title": "Transformisrotated",
          "type": "boolean"
        }
      },
      "required": [
        "sourceReportDigest",
        "inspectorBuildDigest",
        "resolutionX",
        "resolutionY",
        "transformIsRotated"
      ],
      "title": "SpatialAssetPixelResolutionV1",
      "type": "object"
    },
    "SpatialAssetProducerProvenanceV1": {
      "additionalProperties": false,
      "description": "Who the customer says produced the bytes. A declaration, never KSI observation.\n\nV1/V2 submissions always carry a software name and version, so their\nknowledge is ``DECLARED`` by construction. V3 carries its own explicit\n``producerKnowledge`` (``DECLARED``/``PARTIAL``/``UNKNOWN``) with nulls for\nunknown parts; the fabricated label ``\"unknown\"`` never appears here.",
      "properties": {
        "factClass": {
          "const": "DECLARED",
          "default": "DECLARED",
          "title": "Factclass",
          "type": "string"
        },
        "producerKnowledge": {
          "enum": [
            "DECLARED",
            "PARTIAL",
            "UNKNOWN"
          ],
          "title": "Producerknowledge",
          "type": "string"
        },
        "softwareName": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Softwarename"
        },
        "softwareVersion": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Softwareversion"
        },
        "buildIdentifier": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Buildidentifier"
        },
        "producerRunIdentifier": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producerrunidentifier"
        },
        "configurationDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configurationdigest"
        },
        "completedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completedat"
        },
        "sourceNote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcenote"
        }
      },
      "required": [
        "producerKnowledge"
      ],
      "title": "SpatialAssetProducerProvenanceV1",
      "type": "object"
    },
    "VerticalDatum": {
      "description": "산출물이 어느 수직기준인지 — wire 계약에 실리는 값.\n\n``ELLIPSOIDAL_NATIVE`` 는 \"재구성 엔진이 낸 타원체고를 변환 없이 그대로\n쓴다\"는 뜻이다. ``ELLIPSOIDAL`` 과 굳이 나눈 이유는, 전자가 **의도적으로\n선택한 기준**이 아니라 **변환을 하지 못해 남은 상태**임을 소비자가 구분할\n수 있어야 하기 때문이다 — 나중에 격자가 확보되면 이 값이 남아 있는\n산출물이 곧 재처리 대상 목록이 된다.\n\n두 값의 이 차이는 **호환성 판정에는 영향이 없다** — 둘 다 타원체 기준의\n높이라 서로 빼도 되는 값이다(:func:`family_of`). 재처리 대상 표시와\n비교 가능성은 다른 축이다.\n\n**정표고 멤버가 지오이드 모델 이름을 달고 있는 이유.** 정표고가 서 있는\n기준면은 하나다(KVD1964 = 인천 평균해면, EPSG:5193). 그런데 그 높이를\n타원체고와 잇는 지오이드고 N 은 **격자 모델이 준다** — 즉 모델 이름은\n\"이 높이가 어느 격자로 되돌려지는가\"다. 모델이 다르면 국내 지점 대조에서\n수 cm 가 어긋나고(KNGeoid18↔24 실측 비교 0.001~0.071m), 그 크기는 체적\n집계 문턱(``DEFAULT_VOLUME_THRESHOLD_M`` = 0.05m)과 같은 자릿수다. 그래서\n모델을 이름에 박아 두고, **우리가 실제로 격자를 가진 모델만** 타원체고와\n잇는다(:data:`_GEOID_BRIDGEABLE_ORTHOMETRIC`).",
      "enum": [
        "ellipsoidal",
        "ellipsoidal_native",
        "orthometric_kngeoid2018",
        "orthometric_kngeoid2024"
      ],
      "title": "VerticalDatum",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial-asset-description.v1.json"
}
