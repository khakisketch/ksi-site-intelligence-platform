{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.local/contracts/external-delta-publication-worker.v1.json",
  "title": "DeltaPublicationWorkerInputV1",
  "description": "Exact server-issued late-export input for one publication lease.\n\nThe worker must treat this as a re-measurement fence only: it authorizes\nreproducing the sealed ``numeric_result`` bytes from the two capabilities,\nnever fabricating a V2 attempt/admission/authorization or treating the old\ncompleted attempt as live.",
  "$defs": {
    "AnalysisPolicyV2": {
      "additionalProperties": false,
      "description": "The first V2 profile's mathematical identity, without an execution result.",
      "properties": {
        "contractVersion": {
          "const": "external-relative-volume-analysis-policy.v2",
          "default": "external-relative-volume-analysis-policy.v2",
          "title": "Contractversion",
          "type": "string"
        },
        "policyId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policyid",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "profileId": {
          "const": "KSI-GIS-RELATIVE-VOLUME-V2",
          "title": "Profileid",
          "type": "string"
        },
        "profileDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profiledigest",
          "type": "string"
        },
        "algorithmDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Algorithmdigest",
          "type": "string"
        },
        "configDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Configdigest",
          "type": "string"
        },
        "baselineGridRule": {
          "const": "BASELINE_NATIVE_NORTH_UP_AFFINE_V1",
          "title": "Baselinegridrule",
          "type": "string"
        },
        "currentElevationResampling": {
          "const": "BILINEAR",
          "title": "Currentelevationresampling",
          "type": "string"
        },
        "currentMaskResampling": {
          "const": "NEAREST",
          "title": "Currentmaskresampling",
          "type": "string"
        },
        "workAreaRasterization": {
          "const": "CELL_CENTER",
          "title": "Workarearasterization",
          "type": "string"
        },
        "minimumCommonValidFraction": {
          "title": "Minimumcommonvalidfraction",
          "type": "number"
        },
        "thresholdM": {
          "title": "Thresholdm",
          "type": "number"
        },
        "cellAreaRule": {
          "const": "ABSOLUTE_AFFINE_DETERMINANT",
          "title": "Cellarearule",
          "type": "string"
        },
        "deltaRule": {
          "const": "CURRENT_MINUS_BASELINE",
          "title": "Deltarule",
          "type": "string"
        },
        "uncertaintyMethod": {
          "const": "NONE_UNCERTAINTY_M3_NULL_V1",
          "title": "Uncertaintymethod",
          "type": "string"
        },
        "policyDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policydigest"
        }
      },
      "required": [
        "policyId",
        "version",
        "profileId",
        "profileDigest",
        "algorithmDigest",
        "configDigest",
        "baselineGridRule",
        "currentElevationResampling",
        "currentMaskResampling",
        "workAreaRasterization",
        "minimumCommonValidFraction",
        "thresholdM",
        "cellAreaRule",
        "deltaRule",
        "uncertaintyMethod"
      ],
      "title": "AnalysisPolicyV2",
      "type": "object"
    },
