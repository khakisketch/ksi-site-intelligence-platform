{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/contracts/external-validation-policy.v1.json",
  "title": "ExternalValidationPolicyV1",
  "description": "Versioned external-validation policy snapshot. ACTIVE policy shape is further checked by the authoritative model.",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "policyId", "version", "status", "parserBuildDigest", "grammarDigest", "resourceEnvelope", "resourceEnvelopeDigest", "authorityRecordDigest", "inspectionRuleIds", "evidenceRuleIds", "compatibilityMappingDigests", "syntheticTestOnly", "policyDigest"],
  "properties": {"contractVersion": {"const": "external-validation-policy.v1"}, "policyId": {"$ref": "#/$defs/text"}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "ACTIVE", "REVOKED", "SUPERSEDED"]}, "parserBuildDigest": {"$ref": "#/$defs/digest"}, "grammarDigest": {"$ref": "#/$defs/digest"}, "resourceEnvelope": {"oneOf": [{"$ref": "#/$defs/envelope"}, {"type": "null"}]}, "resourceEnvelopeDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "authorityRecordDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "inspectionRuleIds": {"$ref": "#/$defs/ruleIds"}, "evidenceRuleIds": {"$ref": "#/$defs/ruleIds"}, "compatibilityMappingDigests": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/digest"}}, "syntheticTestOnly": {"type": "boolean"}, "policyDigest": {"$ref": "#/$defs/digest"}},
  "$defs": {"text": {"type": "string", "minLength": 1, "maxLength": 255}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "ruleIds": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/text"}}, "envelope": {"type": "object", "additionalProperties": false, "required": ["maxInputBytes", "maxStreamedBytes", "maxTiffDirectories", "maxTiffEntries", "maxPixels", "maxBands", "maxBlocks", "maxDecompressedBytes", "maxSampleBytes", "maxGeometryVertices", "maxCpuSeconds", "maxMemoryBytes", "maxWorkspaceBytes", "maxOutputBytes", "maxTenantConcurrency", "maxQueueDepth", "maxDeadlineSeconds", "leaseDurationSeconds", "maxRetryAttempts", "resourceEnvelopeDigest"], "properties": {"maxInputBytes": {"type": "integer", "exclusiveMinimum": 0}, "maxStreamedBytes": {"type": "integer", "exclusiveMinimum": 0}, "maxTiffDirectories": {"type": "integer", "exclusiveMinimum": 0}, "maxTiffEntries": {"type": "integer", "exclusiveMinimum": 0}, "maxPixels": {"type": "integer", "exclusiveMinimum": 0}, "maxBands": {"type": "integer", "exclusiveMinimum": 0}, "maxBlocks": {"type": "integer", "exclusiveMinimum": 0}, "maxDecompressedBytes": {"type": "integer", "exclusiveMinimum": 0}, "maxSampleBytes": {"type": "integer", "exclusiveMinimum": 0}, "maxGeometryVertices": {"type": "integer", "exclusiveMinimum": 0}, "maxCpuSeconds": {"type": "number", "exclusiveMinimum": 0}, "maxMemoryBytes": {"type": "integer", "exclusiveMinimum": 0}, "maxWorkspaceBytes": {"type": "integer", "exclusiveMinimum": 0}, "maxOutputBytes": {"type": "integer", "exclusiveMinimum": 0}, "maxTenantConcurrency": {"type": "integer", "exclusiveMinimum": 0}, "maxQueueDepth": {"type": "integer", "exclusiveMinimum": 0}, "maxDeadlineSeconds": {"type": "number", "exclusiveMinimum": 0}, "leaseDurationSeconds": {"type": "number", "exclusiveMinimum": 0}, "maxRetryAttempts": {"type": "integer", "exclusiveMinimum": 0}, "resourceEnvelopeDigest": {"$ref": "#/$defs/digest"}}}}
}
