{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/schemas/edge-runtime-profile.v1.json",
  "title": "EdgeRuntimeProfile v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "edgeRuntimeProfileId",
    "validity",
    "siteId",
    "model",
    "calibration",
    "timing"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "edgeRuntimeProfileId": { "$ref": "#/$defs/safeId" },
    "validity": { "$ref": "#/$defs/validity" },
    "siteId": { "type": "string", "minLength": 1 },
    "model": { "$ref": "#/$defs/model" },
    "calibration": { "$ref": "#/$defs/calibration" },
    "timing": { "$ref": "#/$defs/timing" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "type": "string", "format": "date-time" },
        "notAfter": { "type": "string", "format": "date-time" }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lengthM", "widthM", "heightM"],
      "properties": {
        "lengthM": { "type": "number", "exclusiveMinimum": 0 },
        "widthM": { "type": "number", "exclusiveMinimum": 0 },
        "heightM": { "type": "number", "minimum": 0 }
      }
    },
    "classBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClassId", "sourceClassName", "equipmentClass", "measuredDimensions"],
      "properties": {
        "sourceClassId": { "type": "integer", "minimum": 0 },
        "sourceClassName": { "type": "string", "minLength": 1 },
        "equipmentClass": { "type": "string", "minLength": 1 },
        "measuredDimensions": { "$ref": "#/$defs/dimensions" }
      }
    },
    "tensorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputWidth", "inputHeight", "queryCount", "classCount"],
      "properties": {
        "inputWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "inputHeight": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "queryCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "classCount": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelPackId",
        "modelId",
        "onnxArtifactId",
        "registeredOnnxDigest",
        "engineArtifactId",
        "maxOnnxBytes",
        "maxEngineBytes",
        "workspaceBytes",
        "tensorContract",
        "classBindings",
        "scoreThreshold",
        "topK",
        "ontologyVersion",
        "sourceTaxonomy",
        "tensorRtDifferential"
      ],
      "properties": {
        "modelPackId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "onnxArtifactId": { "$ref": "#/$defs/safeId" },
        "registeredOnnxDigest": { "$ref": "#/$defs/digest" },
        "engineArtifactId": { "$ref": "#/$defs/safeId" },
        "maxOnnxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "maxEngineBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "workspaceBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "tensorContract": { "$ref": "#/$defs/tensorContract" },
        "classBindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/classBinding" }
        },
        "scoreThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "topK": { "type": "integer", "minimum": 1 },
        "ontologyVersion": { "type": "string", "minLength": 1 },
        "sourceTaxonomy": { "type": "string", "minLength": 1 },
        "tensorRtDifferential": { "$ref": "#/$defs/tensorRtDifferential" }
      }
    },
    "tensorRtDifferential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationProfileId",
        "evidenceDigest",
        "registeredOnnxDigest",
        "preprocessingContractId",
        "preprocessingConfigDigest",
        "corpusId",
        "corpusDigest",
        "sampleCount",
        "status",
        "confidenceAtol",
        "bboxAtolPx"
      ],
      "properties": {
        "verificationProfileId": { "const": "ksi-dfine-tensorrt-onnx-semantic-v1" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "registeredOnnxDigest": { "$ref": "#/$defs/digest" },
        "preprocessingContractId": { "const": "rtdetr-rgb-bilinear-1over255-v1" },
        "preprocessingConfigDigest": { "$ref": "#/$defs/digest" },
        "corpusId": { "$ref": "#/$defs/safeId" },
        "corpusDigest": { "$ref": "#/$defs/digest" },
        "sampleCount": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "status": { "const": "PASS" },
        "confidenceAtol": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.001 },
        "bboxAtolPx": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "quaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "x", "y", "z"],
      "properties": {
        "w": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "siteFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crs", "verticalDatum", "unit", "transformVersion"],
      "properties": {
        "crs": { "type": "string", "minLength": 1 },
        "verticalDatum": { "type": "string", "minLength": 1 },
        "unit": { "const": "meter" },
        "transformVersion": { "type": "string", "minLength": 1 }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibrationProfileId",
        "siteFrame",
        "wgs84Origin",
        "enuToSite",
        "groundPlaneUpM",
        "intrinsics",
        "cameraToGimbal",
        "cameraOffsetInGimbalM",
        "positionSigmaM",
        "angularSigmaRad",
        "pixelSigmaPx",
        "maxPoseAgeMs"
      ],
      "properties": {
        "calibrationProfileId": { "type": "string", "minLength": 1 },
        "siteFrame": { "$ref": "#/$defs/siteFrame" },
        "wgs84Origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitudeRad", "longitudeRad", "altitudeM"],
          "properties": {
            "latitudeRad": { "type": "number", "minimum": -1.5707963267948966, "maximum": 1.5707963267948966 },
            "longitudeRad": { "type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793 },
            "altitudeM": { "type": "number" }
          }
        },
        "enuToSite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rotation", "translationM"],
          "properties": {
            "rotation": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              }
            },
            "translationM": { "$ref": "#/$defs/vector3" }
          }
        },
        "groundPlaneUpM": { "type": "number" },
        "intrinsics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceWidth", "referenceHeight", "focalXPx", "focalYPx", "principalXPx", "principalYPx"],
          "properties": {
            "referenceWidth": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "referenceHeight": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "focalXPx": { "type": "number", "exclusiveMinimum": 0 },
            "focalYPx": { "type": "number", "exclusiveMinimum": 0 },
            "principalXPx": { "type": "number", "minimum": 0 },
            "principalYPx": { "type": "number", "minimum": 0 }
          }
        },
        "cameraToGimbal": { "$ref": "#/$defs/quaternion" },
        "cameraOffsetInGimbalM": { "$ref": "#/$defs/vector3" },
        "positionSigmaM": { "type": "number", "minimum": 0 },
        "angularSigmaRad": { "type": "number", "minimum": 0 },
        "pixelSigmaPx": { "type": "number", "exclusiveMinimum": 0 },
        "maxPoseAgeMs": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireSensorAlignment", "maxAlignmentMs"],
      "properties": {
        "requireSensorAlignment": { "const": true },
        "maxAlignmentMs": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    }
  }
}
