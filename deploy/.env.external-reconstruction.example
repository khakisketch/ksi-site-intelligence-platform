# Copy outside the repository, set mode 0600, and replace every value.
# This file contains paths and deployment coordinates only.  Do not place a
# Core token, signing key, customer artifact, catalog, or manifest in Git.
KSI_EXTERNAL_RC_PROJECT_NAME=ksi-external-rc
KSI_EXTERNAL_RC_STATE_DIR=/var/lib/ksi-external-runtime/candidate
KSI_EXTERNAL_RC_RELEASE_EVIDENCE=/etc/ksi-external-runtime/release-evidence.json
KSI_EXTERNAL_RC_HOST=REPLACE-WITH-TAILNET-MAGICDNS-HOST.ts.net
KSI_EXTERNAL_RC_APP_PORT=10100
KSI_EXTERNAL_RC_IDENTITY_PORT=10101
KSI_EXTERNAL_RC_API_PORT=10102
KSI_EXTERNAL_RC_OBJECTS_PORT=10103
KSI_EXTERNAL_RC_MINIO_CONSOLE_PORT=10104
KSI_EXTERNAL_RC_MINIO_ROOT_USER=REPLACE-OUTSIDE-GIT
KSI_EXTERNAL_RC_MINIO_ROOT_PASSWORD=REPLACE-OUTSIDE-GIT
KSI_EXTERNAL_RC_PRINCIPAL_TOKENS_JSON=[]
