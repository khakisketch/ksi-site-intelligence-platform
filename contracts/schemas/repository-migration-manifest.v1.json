{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/schemas/repository-migration-manifest.v1.json",
  "title": "KSI Repository Migration Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "migrationId",
    "decisionDate",
    "status",
    "authority",
    "requirements",
    "baseline",
    "moves",
    "cleanup",
    "protectedPaths",
    "verification"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0"},
    "migrationId": {"const": "REPO-NORM-R3-SERVICE-PACKAGE-BOUNDARY"},
    "decisionDate": {"type": "string", "format": "date"},
    "status": {"enum": ["IN_PROGRESS", "COMPLETE"]},
    "authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"pattern": "^(R3|REQ)-[A-Z]+-[0-9]{3}$", "type": "string"}
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "branch",
        "trackedChanges",
        "untrackedPorcelainEntries",
        "worktreeDiffSha256",
        "indexDiffSha256",
        "porcelainStatusSha256",
        "ownership"
      ],
      "properties": {
        "head": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "branch": {"type": "string", "minLength": 1},
        "trackedChanges": {"type": "integer", "minimum": 0},
        "untrackedPorcelainEntries": {"type": "integer", "minimum": 0},
        "worktreeDiffSha256": {"$ref": "#/$defs/sha256"},
        "indexDiffSha256": {"$ref": "#/$defs/sha256"},
        "porcelainStatusSha256": {"$ref": "#/$defs/sha256"},
        "ownership": {"const": "PRE_EXISTING_HUMAN_WIP"}
      }
    },
    "moves": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/move"}
    },
    "cleanup": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cleanup"}
    },
    "protectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryPath"}
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/verification"}
    }
  },
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": {"anyOf": [{"pattern": "^/"}, {"pattern": "(^|/)\\.\\.(/|$)"}]}
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "distribution",
        "importName",
        "runtimeKind",
        "owner",
        "consumers",
        "references",
        "rollback"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/repositoryPath"},
        "destination": {"$ref": "#/$defs/repositoryPath"},
        "distribution": {"type": "string", "minLength": 1},
        "importName": {"pattern": "^[a-z][a-z0-9_]*$", "type": "string"},
        "runtimeKind": {"const": "IMPORT_ONLY_PACKAGE"},
        "owner": {"type": "string", "minLength": 1},
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "state",
        "sources",
        "sourcePatterns",
        "evidence",
        "replacement",
        "rollback"
      ],
      "properties": {
        "id": {"pattern": "^[a-z0-9][a-z0-9-]*$", "type": "string"},
        "classification": {"const": "REMOVE"},
        "state": {"enum": ["PENDING", "EXECUTED"]},
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "sourcePatterns": {
          "type": "array",
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "replacement": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "claim"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING", "PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
        "claim": {"type": "string", "minLength": 1}
      }
    }
  }
}
