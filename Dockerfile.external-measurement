# Independently released, contained checkpoint and relative-volume image.
# It has no listener or operator-selectable argv; authority arrives solely over
# the fixed bounded stdin protocol enforced by the rootless launcher.
FROM python:3.12.14-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217 AS runtime-builder

COPY --from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages packages
COPY services services
RUN uv sync --locked --package ksi-processing-controller --no-dev

FROM python:3.12.14-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/20260824T000000Z|' \
      -e 's|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/20260824T000000Z|' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update -qq \
    && apt-get install -y -qq --no-install-recommends libexpat1=2.8.3-1~deb13u1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=runtime-builder /app/.venv /app/.venv
COPY --from=runtime-builder /app/packages/change-detection /app/packages/change-detection
COPY --from=runtime-builder /app/packages/domain /app/packages/domain
COPY --from=runtime-builder /app/packages/event-contracts /app/packages/event-contracts
COPY --from=runtime-builder /app/packages/geo-core /app/packages/geo-core
COPY --from=runtime-builder /app/packages/geo-spatial /app/packages/geo-spatial
COPY --from=runtime-builder /app/packages/perception /app/packages/perception
COPY --from=runtime-builder /app/services/processing-controller /app/services/processing-controller

# Production execution may replace this distinct non-root default only with
# the UID/GID bound by the signed measurement execution manifest.
RUN useradd --create-home --uid 10004 ksi-measurement-image
USER ksi-measurement-image

CMD ["/app/.venv/bin/ksi-external-measurement-entrypoint"]
