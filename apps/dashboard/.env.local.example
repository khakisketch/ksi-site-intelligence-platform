# scripts/run_core_dev.py 로 로컬 Core 서버를 띄운다.
CORE_API_BASE_URL=http://127.0.0.1:8000

# 대시보드는 더 이상 전역 고정 토큰으로 모든 요청을 대행하지 않는다(risk
# dashboard-unauthenticated-signing-proxy 폐쇄) — 브라우저에서 /login 화면에 로그인해야
# 한다. scripts/run_core_dev.py 실행 출력에 역할별 dev 토큰 3종이 출력되니 그중 하나를
# 붙여넣으면 된다(예: dev-admin-token, dev-field-operator-token, dev-viewer-token).
