    "RelativeVolumeCoverageWitnessV2": {
      "additionalProperties": false,
      "description": "Lossless bounded full-zone masks for a baseline-grid calculation.\n\nBits are row-major and big-endian within each byte.  ``selected`` is the\ncomplete cell-centre WorkArea mask; ``commonValid`` is the exact cells that\nhad finite values in both epochs; ``unavailable`` is the selected-minus-\ncommon mask.  The first fixed profile has a zero threshold, so its\nthreshold-excluded mask must always be empty.",
      "properties": {
        "contractVersion": {
          "const": "external-relative-volume-coverage-witness.v2",
          "default": "external-relative-volume-coverage-witness.v2",
          "title": "Contractversion",
          "type": "string"
        },
        "rows": {
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "columns": {
          "exclusiveMinimum": 0,
          "title": "Columns",
          "type": "integer"
        },
        "rowOffset": {
          "title": "Rowoffset",
          "type": "integer"
        },
        "columnOffset": {
          "title": "Columnoffset",
          "type": "integer"
        },
        "selectedMaskB64": {
          "maxLength": 2000000,
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "title": "Selectedmaskb64",
          "type": "string"
        },
        "commonValidMaskB64": {
          "maxLength": 2000000,
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "title": "Commonvalidmaskb64",
          "type": "string"
        },
        "unavailableMaskB64": {
          "maxLength": 2000000,
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "title": "Unavailablemaskb64",
          "type": "string"
        },
        "thresholdExcludedMaskB64": {
          "maxLength": 2000000,
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "title": "Thresholdexcludedmaskb64",
          "type": "string"
        },
        "selectedCellCount": {
          "minimum": 0,
          "title": "Selectedcellcount",
          "type": "integer"
        },
        "commonValidCellCount": {
          "minimum": 0,
          "title": "Commonvalidcellcount",
          "type": "integer"
        },
        "unavailableCellCount": {
          "minimum": 0,
          "title": "Unavailablecellcount",
          "type": "integer"
        },
        "thresholdExcludedCellCount": {
          "minimum": 0,
          "title": "Thresholdexcludedcellcount",
          "type": "integer"
        },
        "cellAreaM2": {
          "exclusiveMinimum": 0.0,
          "title": "Cellaream2",
          "type": "number"
        },
        "selectedAreaM2": {
          "minimum": 0.0,
          "title": "Selectedaream2",
          "type": "number"
        },
        "commonValidAreaM2": {
          "minimum": 0.0,
          "title": "Commonvalidaream2",
          "type": "number"
        },
        "bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds",
          "type": "array"
        },
        "coverageWitnessDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coveragewitnessdigest"
        }
      },
      "required": [
        "rows",
        "columns",
        "rowOffset",
        "columnOffset",
        "selectedMaskB64",
        "commonValidMaskB64",
        "unavailableMaskB64",
        "thresholdExcludedMaskB64",
