# KSI Core / 처리 워커 운영 환경변수 예제
#
# 이 파일을 `.env` 로 복사해 값을 채운 뒤 `docker compose --env-file` 로 넘긴다.
# **`.env` 자체는 커밋하지 않는다**(리포지토리 .gitignore 가 막는다).
#
# 값의 근거는 코드가 SSOT 다 — Core 는 services/core/src/ksi_core/production.py,
# 워커는 services/processing-controller/src/ksi_processing_controller/runner.py.
# 아래 "필수"는 그 코드가 없으면 RuntimeError 로 즉시 기동을 거부하는 것들이다
# (조용한 기본값을 두지 않는 것이 의도된 설계다 — production.py 모듈 docstring).
#
# 절차 전체는 docs/ops/DEPLOYMENT.md 참조.

# ─────────────────────────────────────────────────────────────────────────────
# Core — 필수 (하나라도 없으면 기동 거부)
# ─────────────────────────────────────────────────────────────────────────────

# 원장(append-only journal)이 사는 디렉터리. **영속 볼륨이어야 한다** —
# 컨테이너와 함께 사라지면 현장·임무·산출물 이력이 전부 사라진다.
KSI_CORE_DATA_DIR=/var/lib/ksi/data

# Mission Contract 서명키 디렉터리. `keys.json` 매니페스트 + 키 파일이 여기 있어야 한다.
# **Core 는 키를 새로 만들지 않는다** — 이미 있는 것만 읽는다. 컨테이너 재생성마다 새 키가
# 생기면 이미 현장에 발급된 계약이 전부 검증 실패하기 때문이다(서버가 죽어도 로컬에서
# 유효한 계약은 유효해야 한다는 제품 전제). 반드시 컨테이너 밖 영속 볼륨에 둔다.
# 최초 생성·회전 절차: docs/security/SIGNING_KEY_LIFECYCLE.md
KSI_CORE_SIGNING_KEYS_DIR=/var/lib/ksi/signing-keys

# 증거·3D 산출물 객체 저장소(S3 호환). MinIO 면 그 엔드포인트, AWS S3 면 리전 엔드포인트.
# **선택이 아니다** — 이게 없으면 증거·3D 파이프라인 전체가 조용히 404 인 서버가 된다.
KSI_CORE_S3_ENDPOINT=http://minio:9000
KSI_CORE_S3_BUCKET=ksi-evidence

# 접근 토큰 목록 — **원문이 아니라 sha256 digest 만** 싣는다(소문자 64자리 hex).
# 서버 메모리·로그·환경변수 어디에도 원문 토큰이 남지 않는 것이 이 규약의 목적이다.
#
# digest 만드는 법:
#   TOKEN=$(openssl rand -hex 32)                            # 이 원문을 사용자에게 전달한다
#   printf '%s' "$TOKEN" | sha256sum | awk '{print $1}'      # 이 digest 를 아래 JSON 에 넣는다
#   (awk 를 빼면 sha256sum 이 붙이는 뒤쪽 "  -" 까지 들어가 기동이 거부된다)
#
# 필드: tokenSha256(필수) · principalId(필수) · kind(필수) · role(OPERATOR 일 때 필수)
#       deviceId(EDGE_DEVICE 일 때) · status(ACTIVE|REVOKED, 기본 ACTIVE)
#       notAfter(ISO 8601 tz-aware, 없으면 만료 없음)
# kind: OPERATOR | EDGE_DEVICE | PROCESSING_WORKER
# role: ADMIN | FIELD_OPERATOR | VIEWER
#
# 회전 중에는 같은 principalId 로 이전 digest(notAfter 로 유예기간 종료)와
# 새 digest(notAfter 없음)를 함께 배포한다 — docs/security/AUTH_TOKEN_ROTATION.md
KSI_CORE_PRINCIPAL_TOKENS_JSON=[{"tokenSha256":"<64자리 hex>","principalId":"admin-1","kind":"OPERATOR","role":"ADMIN"},{"tokenSha256":"<64자리 hex>","principalId":"worker-1","kind":"PROCESSING_WORKER"}]

# 객체 저장소 자격증명 — boto3 기본 체인으로 들어간다(코드가 따로 읽지 않는다).
# 클라우드에서 IAM role 을 쓰면 이 둘을 비우고 role 을 붙인다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 워커 — 선택 (이 compose 는 core·worker 가 같은 .env 를 공유하므로 여기 둔다)
# ─────────────────────────────────────────────────────────────────────────────

# 정표고(해발) 설계도면을 받으려면 국가 지오이드 격자를 가리켜야 한다.
# **읽는 쪽은 워커다** — Core 는 이 변수를 읽지 않는다(production.py 에 참조 0건).
# Core 는 "이을 수 있는 종류인가"만 순수 표로 답하고, 격자를 실제로 읽어 변환하는
# 것은 워커다(design_conformance_requests.py 모듈 docstring). Core 가 자기 환경을
# 보고 답하면 워커 능력에 대한 거짓말이 된다.
# 미설정이면 정표고 설계면은 계산되지 않고 **거부된다**(숫자를 지어내지 않는다).
# 격자 없이 변환하면 한국에서 20~30m 가 조용히 틀리기 때문이다.
# 취득·검증 절차: docs/geo/GEOID_ACQUISITION.md (파일은 저장소에 함께 있다)
KSI_GEOID_GRID=/app/data/geoid/KNGeoid24.tif

# ─────────────────────────────────────────────────────────────────────────────
# Core — 선택
# ─────────────────────────────────────────────────────────────────────────────

# 로그 레벨(기본 INFO)
KSI_CORE_LOG_LEVEL=INFO

# OpenAPI 문서 노출 여부. 운영에서는 켜지 않는 것이 기본이다.
KSI_CORE_EXPOSE_DOCS=0

# 원장 세그먼트 크기·edge-sync 스냅샷 주기 — 기본값이 있다. 성능 문제가 실제로
# 관측되기 전에는 건드리지 않는다.
# KSI_CORE_JOURNAL_SEGMENT_BYTES=
# KSI_CORE_EDGE_SYNC_SNAPSHOT_EVERY=

# ─────────────────────────────────────────────────────────────────────────────
# 처리 워커 — 재구성(ODM)·비교·설계 대비 잔량을 실제로 계산하는 프로세스
# ─────────────────────────────────────────────────────────────────────────────

KSI_WORKER_CORE_BASE_URL=http://core:8000

# 위 PRINCIPAL_TOKENS_JSON 에 PROCESSING_WORKER 로 등록한 토큰의 **원문**.
# (Core 는 digest 를 갖고, 워커는 원문을 갖는다.)
KSI_WORKER_CORE_TOKEN=

KSI_WORKER_NODEODM_BASE_URL=http://nodeodm:3000

# 워커가 사진을 내려받아 재구성하는 작업 디렉터리. 큰 용량이 필요하고,
# 중단 후 재개를 위해 영속 볼륨을 권장한다.
KSI_WORKER_WORK_DIR=/var/lib/ksi/worker

# 폴링·하트비트 주기(초) — 기본값이 있다.
# KSI_WORKER_POLL_INTERVAL_SECONDS=
# KSI_WORKER_HEARTBEAT_INTERVAL_SECONDS=

KSI_WORKER_LOG_LEVEL=INFO
KSI_WORKER_LOG_FORMAT=json

# (선택) 동적 객체(사람·차량) 마스킹 — PRD §15.2 ④. **미설정이면(기본) 마스킹
# 없이 지금까지와 동일하게 동작한다** — torch·모델 가중치가 모든 배포에 있는
# 게 아니라서([dfine] extra, base 의존이 아님) 기본은 반드시 꺼짐이어야 한다.
# 값을 주면 그 디렉터리에서 D-FINE-S 탐지기를 로드해 재구성 제출마다 사람·
# 차량 영역의 마스크를 함께 싣는다(NodeODM 실물 대상 검증됨 — odm_masking.py
# 모듈 docstring).
#
# 받는 법:
#   uv run python tools/fetch_model.py ksi-person-detector-dfine-s-coco
#   → models/dfine-small-coco/<revision>/ 를 이 변수에 준다.
#
# **설정했는데 로드가 실패하면(경로 없음·digest 불일치·[dfine] extra 미설치 등)
# 워커가 기동 자체를 거부한다(fail-closed)** — "마스킹을 켰다고 믿고 있는데
# 실제로는 한 번도 지운 적 없는 상태"를 조용히 허용하지 않는다. 원치 않으면
# 이 변수를 비운다.
# KSI_WORKER_DYNAMIC_OBJECT_MODEL_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (compose 로 함께 띄울 때만)
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
