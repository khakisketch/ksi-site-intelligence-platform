{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/schemas/risk-policy-pack.v1.json",
  "title": "RiskPolicyPack v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "riskPolicyPackId",
    "validity",
    "calibrationProfileId",
    "equipmentPolicies"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "riskPolicyPackId": { "type": "string", "minLength": 1 },
    "validity": { "$ref": "#/$defs/validity" },
    "calibrationProfileId": { "type": "string", "minLength": 1 },
    "equipmentPolicies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/equipmentPolicy" }
    }
  },
  "$defs": {
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "type": "string", "format": "date-time" },
        "notAfter": { "type": "string", "format": "date-time" }
      }
    },
    "equipmentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equipmentClass",
        "riskFieldPolicyId",
        "footprint",
        "prediction",
        "covarianceSigmaMultiplier",
        "occlusionExpansionM",
        "severity"
      ],
      "properties": {
        "equipmentClass": { "type": "string", "minLength": 1 },
        "riskFieldPolicyId": { "type": "string", "minLength": 1 },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lengthM", "widthM", "heightM"],
          "properties": {
            "lengthM": { "type": "number", "exclusiveMinimum": 0 },
            "widthM": { "type": "number", "exclusiveMinimum": 0 },
            "heightM": { "type": "number", "minimum": 0 }
          }
        },
        "prediction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["horizonSeconds", "samplePeriodSeconds"],
          "properties": {
            "horizonSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "samplePeriodSeconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "covarianceSigmaMultiplier": { "type": "number", "minimum": 0 },
        "occlusionExpansionM": { "type": "number", "minimum": 0 },
        "severity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
