/* edge/psdk-tap/config/dji_sdk_app_info.h.example
 *
 * 이 파일은 예시 템플릿이다 — 실제 자격증명이 아니다(전부 플레이스홀더 문자열).
 * 빌드하려면:
 *   1) 이 파일을 같은 디렉터리에 dji_sdk_app_info.h 로 복사한다.
 *   2) developer.dji.com 에서 발급받은 실제 App Name/ID/Key/License 로 값을 채운다.
 * dji_sdk_app_info.h 라는 이름의 파일은 저장소 어느 경로에 있든 저장소 루트
 * .gitignore 규칙으로 항상 무시된다 — 실수로 커밋되지 않는다. edge/psdk-tap/
 * CMakeLists.txt 는 이 파일이 없으면 configure 단계에서 명확한 메시지로
 * 실패한다(조용히 스텁을 만들지 않는다).
 */
#ifndef KSI_PSDK_TAP_DJI_SDK_APP_INFO_H
#define KSI_PSDK_TAP_DJI_SDK_APP_INFO_H

#define USER_APP_NAME               "your_app_name"
#define USER_APP_ID                 "your_app_id"
#define USER_APP_KEY                "your_app_key"
#define USER_APP_LICENSE            "your_app_license"
#define USER_DEVELOPER_ACCOUNT      "your_developer_account"
#define USER_BAUD_RATE              "460800"

#endif /* KSI_PSDK_TAP_DJI_SDK_APP_INFO_H */
