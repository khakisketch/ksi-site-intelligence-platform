# HIL-0 deployable DJI Gateway image. It has no embedded provider, credentials,
# authority records, or route defaults; runner --config is mandatory.
FROM python:3.12.14-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

COPY --from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 /uv /uvx /bin/

WORKDIR /app
COPY . .
RUN uv sync --locked --all-packages \
    && useradd --create-home --uid 10003 ksi-gateway

USER ksi-gateway
EXPOSE 8080

# The operator must mount owner-only config/token files and an explicit Unix
# bridge socket. Missing --config is an intentional boot failure.
ENTRYPOINT ["/app/.venv/bin/ksi-dji-gateway"]
