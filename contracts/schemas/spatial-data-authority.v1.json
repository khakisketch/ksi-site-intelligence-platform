        "organizationId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Organizationid",
          "type": "string"
        },
        "workerPrincipalId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Workerprincipalid",
          "type": "string"
        },
        "workerInstanceId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Workerinstanceid",
          "type": "string"
        },
        "preparationProfile": {
          "const": "ksi-native-window.v1",
          "default": "ksi-native-window.v1",
          "title": "Preparationprofile",
          "type": "string"
