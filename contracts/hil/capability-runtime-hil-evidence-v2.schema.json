{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/contracts/hil/capability-runtime-hil-evidence-v2.schema.json",
  "title": "KSI HIL-1R Route-1 physical evidence v2",
  "description": "Offline non-actuating raw capture and deterministic verifier artifact. It never creates CAP-2 qualification, approval, activation, or verified capability evidence.",
  "oneOf": [{"$ref": "#/$defs/rawCapture"}, {"$ref": "#/$defs/evidence"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["activationEvidence", "authorityDecisionCreatedByTool", "authorityJournalSnapshot", "operationalCapabilityActivation", "productApprovalEvidence", "productCapabilityApproval", "qualificationScope", "routeEvidenceQualification"], "properties": {"routeEvidenceQualification": {"const": "NOT_QUALIFIED"}, "qualificationScope": {"const": "ROUTE_1_HIL_RAW_EVIDENCE_ONLY"}, "authorityDecisionCreatedByTool": {"const": false}, "productCapabilityApproval": {"enum": ["APPROVED", "NOT_APPROVED"]}, "operationalCapabilityActivation": {"enum": ["ACTIVATED", "NOT_ACTIVATED"]}, "authorityJournalSnapshot": {"$ref": "#/$defs/rawRef"}, "productApprovalEvidence": {"$ref": "#/$defs/optionalAuthorityEvidence"}, "activationEvidence": {"$ref": "#/$defs/optionalAuthorityEvidence"}}},
    "optionalAuthorityEvidence": {"type": ["null", "object"], "additionalProperties": false, "required": ["digest", "id"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "rawArtifact": {"type": "object", "additionalProperties": false, "required": ["ref", "role", "sha256", "sizeBytes"], "properties": {"ref": {"type": "string", "minLength": 1}, "role": {"enum": ["PSDK_RAW_LOG", "GATEWAY_RAW_LOG", "CORE_RAW_LOG", "PEER_RAW_LOG", "OPERATOR_ATTESTATION", "TIMING_LOG", "OBSERVATION_JOURNAL_SNAPSHOT", "AUTHORITY_JOURNAL_SNAPSHOT", "MISSION_REFERENCE"]}, "sha256": {"$ref": "#/$defs/digest"}, "sizeBytes": {"type": "integer", "minimum": 1}}},
    "rawRef": {"type": "object", "additionalProperties": false, "required": ["rawArtifactRef", "rawArtifactSha256"], "properties": {"rawArtifactRef": {"type": "string", "minLength": 1}, "rawArtifactSha256": {"$ref": "#/$defs/digest"}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["evidenceRefs", "id", "observedAtMonotonicNs", "status"], "properties": {"id": {"enum": ["A_ABSENT_UNAVAILABLE_NOT_READY", "B_REAL_CONNECT_CORE_ACCEPTS", "C_FLAG_OFF_DENY_NO_INVOKE", "D_MISSION_DENY_NO_INVOKE", "E_SAFE_ON_ALLOW_INVOKE", "F_SYNTHETIC_SEND_INDEPENDENT_PEER_RECEIPT", "G_DISCONNECT_UNAVAILABLE_PROVIDER_DENIED", "H_EXPIRY_STALE_DENY", "I_RECONNECT_NEW_OBSERVATION_RUNTIME_RECOVERY_NO_CAP4", "J_COMPANION_RESTART_NEW_SIGNAL_OBSERVATION_RECOVERY"]}, "observedAtMonotonicNs": {"type": "integer", "minimum": 0}, "status": {"enum": ["OBSERVED", "FAIL", "INCONCLUSIVE", "NOT_CAPTURED"]}, "evidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rawRef"}}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["availability", "coreIngressResult", "expiresAtUtc", "integrationPath", "observationId", "observedAtMonotonicNs", "observedAtUtc", "producer", "scenarioId", "signalId", "subjectPortId"], "properties": {"scenarioId": {"enum": ["A_ABSENT_UNAVAILABLE_NOT_READY", "B_REAL_CONNECT_CORE_ACCEPTS", "G_DISCONNECT_UNAVAILABLE_PROVIDER_DENIED", "I_RECONNECT_NEW_OBSERVATION_RUNTIME_RECOVERY_NO_CAP4", "J_COMPANION_RESTART_NEW_SIGNAL_OBSERVATION_RECOVERY"]}, "observationId": {"type": "string", "minLength": 1}, "signalId": {"type": "string", "minLength": 1}, "availability": {"enum": ["AVAILABLE", "UNAVAILABLE"]}, "observedAtMonotonicNs": {"type": "integer", "minimum": 0}, "observedAtUtc": {"$ref": "#/$defs/utc"}, "expiresAtUtc": {"$ref": "#/$defs/utc"}, "subjectPortId": {"type": "string", "minLength": 1}, "integrationPath": {"const": "PSDK_MANIFOLD"}, "producer": {"type": "string", "minLength": 1}, "coreIngressResult": {"enum": ["ACCEPTED", "REJECTED"]}}},
    "preflight": {"type": "object", "additionalProperties": false, "required": ["atMonotonicNs", "decision", "featureFlagState", "providerInvoked", "reasonCode", "requestScope", "scenarioId", "timestampUtc"], "properties": {"scenarioId": {"enum": ["A_ABSENT_UNAVAILABLE_NOT_READY", "C_FLAG_OFF_DENY_NO_INVOKE", "D_MISSION_DENY_NO_INVOKE", "E_SAFE_ON_ALLOW_INVOKE", "G_DISCONNECT_UNAVAILABLE_PROVIDER_DENIED", "H_EXPIRY_STALE_DENY"]}, "atMonotonicNs": {"type": "integer", "minimum": 0}, "requestScope": {"type": "string", "minLength": 1}, "decision": {"enum": ["ALLOW", "DENY"]}, "reasonCode": {"type": "string", "minLength": 1}, "timestampUtc": {"$ref": "#/$defs/utc"}, "featureFlagState": {"enum": ["ON", "OFF"]}, "providerInvoked": {"type": "boolean"}}},
    "event": {"type": "object", "additionalProperties": false, "required": ["atMonotonicNs", "eventId", "eventType", "rawArtifactRef", "rawArtifactSha256", "scenarioId", "timestampUtc"], "properties": {"scenarioId": {"enum": ["A_ABSENT_UNAVAILABLE_NOT_READY", "B_REAL_CONNECT_CORE_ACCEPTS", "C_FLAG_OFF_DENY_NO_INVOKE", "D_MISSION_DENY_NO_INVOKE", "E_SAFE_ON_ALLOW_INVOKE", "F_SYNTHETIC_SEND_INDEPENDENT_PEER_RECEIPT", "G_DISCONNECT_UNAVAILABLE_PROVIDER_DENIED", "H_EXPIRY_STALE_DENY", "I_RECONNECT_NEW_OBSERVATION_RUNTIME_RECOVERY_NO_CAP4", "J_COMPANION_RESTART_NEW_SIGNAL_OBSERVATION_RECOVERY"]}, "eventId": {"type": "string", "minLength": 1}, "eventType": {"enum": ["ROUTE_NOT_READY", "MOP_CONNECTED", "CORE_INGRESS_ACCEPTED", "PRELIGHT_DENIED", "PROVIDER_INVOKED", "TRANSMISSION_HANDOFF", "PEER_RECEIPT", "MOP_DISCONNECTED", "PROVIDER_DENIED", "OBSERVATION_EXPIRED", "MOP_RECONNECTED", "RUNTIME_RECOVERED", "COMPANION_RESTART"]}, "atMonotonicNs": {"type": "integer", "minimum": 0}, "timestampUtc": {"$ref": "#/$defs/utc"}, "operationId": {"type": "string", "minLength": 1}, "payloadSha256": {"$ref": "#/$defs/digest"}, "rawArtifactRef": {"type": "string", "minLength": 1}, "rawArtifactSha256": {"$ref": "#/$defs/digest"}}},
    "rawCapture": {"type": "object", "additionalProperties": false, "required": ["artifactType", "authority", "bundleTransfer", "featureFlag", "mission", "nonActuating", "observationJournalSnapshot", "observations", "physicalEvents", "preflightDecisions", "rawArtifacts", "route", "scenarioCaptures", "schemaVersion", "session", "software"], "properties": {"artifactType": {"const": "HIL_1R_ROUTE_1_RAW_CAPTURE"}, "schemaVersion": {"const": "capability-runtime-hil-evidence-v2"}, "nonActuating": {"const": true}, "authority": {"$ref": "#/$defs/authority"}, "session": {"$ref": "#/$defs/session"}, "route": {"$ref": "#/$defs/route"}, "software": {"$ref": "#/$defs/software"}, "featureFlag": {"$ref": "#/$defs/featureFlag"}, "mission": {"$ref": "#/$defs/mission"}, "rawArtifacts": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/rawArtifact"}}, "observationJournalSnapshot": {"$ref": "#/$defs/rawRef"}, "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}, "preflightDecisions": {"type": "array", "items": {"$ref": "#/$defs/preflight"}}, "physicalEvents": {"type": "array", "items": {"$ref": "#/$defs/event"}}, "bundleTransfer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bundleTransfer"}]}, "scenarioCaptures": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/scenario"}}}},
    "session": {"type": "object", "additionalProperties": false, "required": ["endedAtUtc", "evidenceArtifactId", "startedAtUtc", "testEnvironment", "testRunId"], "properties": {"evidenceArtifactId": {"type": "string", "minLength": 1}, "testRunId": {"type": "string", "minLength": 1}, "startedAtUtc": {"$ref": "#/$defs/utc"}, "endedAtUtc": {"$ref": "#/$defs/utc"}, "testEnvironment": {"type": "string", "minLength": 1}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["capabilityId", "configuredDeploymentDigest", "firmwareBuildVersions", "freshnessPolicy", "integrationPath", "physicalComponentIdentities", "routeId", "subjectPortId"], "properties": {"routeId": {"const": "HIL_ROUTE_1"}, "capabilityId": {"const": "EDGE_UPLINK"}, "subjectPortId": {"type": "string", "minLength": 1}, "integrationPath": {"const": "PSDK_MANIFOLD"}, "configuredDeploymentDigest": {"$ref": "#/$defs/digest"}, "freshnessPolicy": {"type": "object", "additionalProperties": false, "required": ["digest", "id"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}}, "physicalComponentIdentities": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/physicalIdentity"}}, "firmwareBuildVersions": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/package"}}}},
    "physicalIdentity": {"type": "object", "additionalProperties": false, "required": ["componentKind", "hardwareRevision", "identity", "manufacturer", "model"], "properties": {"componentKind": {"enum": ["AIRCRAFT", "RC", "MANIFOLD", "PEER_ENDPOINT"]}, "identity": {"type": "string", "minLength": 1}, "manufacturer": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "hardwareRevision": {"type": "string", "minLength": 1}}},
    "package": {"type": "object", "additionalProperties": false, "required": ["name", "sha256", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "software": {"type": "object", "additionalProperties": false, "required": ["buildDigest", "dpkPackageDigest", "exactPsdkVersion", "gitRevision", "operatorId", "packageInventory"], "properties": {"buildDigest": {"$ref": "#/$defs/digest"}, "gitRevision": {"type": "string", "minLength": 7}, "operatorId": {"type": "string", "minLength": 1}, "exactPsdkVersion": {"type": "string", "minLength": 1}, "dpkPackageDigest": {"$ref": "#/$defs/digest"}, "packageInventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}}}},
    "featureFlag": {"type": "object", "additionalProperties": false, "required": ["digest", "id", "state"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "state": {"enum": ["ON", "OFF"]}}},
    "mission": {"type": "object", "additionalProperties": false, "required": ["missionContractDigest", "missionId", "missionReference", "policyResult"], "properties": {"missionId": {"type": "string", "minLength": 1}, "missionContractDigest": {"$ref": "#/$defs/digest"}, "missionReference": {"$ref": "#/$defs/rawRef"}, "policyResult": {"enum": ["ALLOW", "DENY"]}}},
    "bundleTransfer": {"type": "object", "additionalProperties": false, "required": ["acceptedFramesAfter", "acceptedFramesBefore", "claimedSha256", "independentPeerLog", "objectMetadata", "payloadKind", "peerReceiptTimestampUtc", "peerValidatedMetadata", "providerOperationId", "providerRawLog"], "properties": {"providerOperationId": {"type": "string", "minLength": 1}, "payloadKind": {"const": "EDGE_BUNDLE_METADATA_ONLY"}, "acceptedFramesBefore": {"type": "integer", "minimum": 0}, "acceptedFramesAfter": {"type": "integer", "minimum": 1}, "claimedSha256": {"$ref": "#/$defs/digest"}, "objectMetadata": {"$ref": "#/$defs/objectMetadata"}, "peerValidatedMetadata": {"$ref": "#/$defs/objectMetadata"}, "providerRawLog": {"$ref": "#/$defs/rawRef"}, "independentPeerLog": {"$ref": "#/$defs/rawRef"}, "peerReceiptTimestampUtc": {"$ref": "#/$defs/utc"}}},
    "objectMetadata": {"type": "object", "additionalProperties": false, "required": ["contentType", "objectRef", "sha256", "sizeBytes"], "properties": {"objectRef": {"type": "string", "minLength": 1}, "contentType": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "sizeBytes": {"type": "integer", "minimum": 1}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["artifactType", "authority", "rawCapture", "schemaVersion", "verifierDecision"], "properties": {"artifactType": {"const": "HIL_1R_ROUTE_1_EVIDENCE"}, "schemaVersion": {"const": "capability-runtime-hil-evidence-v2"}, "authority": {"$ref": "#/$defs/authority"}, "rawCapture": {"$ref": "#/$defs/rawCapture"}, "verifierDecision": {"type": "object", "additionalProperties": false, "required": ["reasonCodes", "result", "verifiedAtUtc"], "properties": {"result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "reasonCodes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "verifiedAtUtc": {"$ref": "#/$defs/utc"}}}}}
  }
}
