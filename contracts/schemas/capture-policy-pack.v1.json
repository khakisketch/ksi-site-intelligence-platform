{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/contracts/capture-policy-pack.v1.json",
  "title": "CapturePolicyPack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "maxAttemptsPerTarget", "maxExtraTimeSeconds", "minimumBatteryReservePercent", "maximumGsdCmPerPx", "minimumOverlapRatio", "maximumBlurScore", "maximumOcclusionRatio", "maximumGimbalAdjustmentDeg", "allowedActions", "preauthorizedViewpointIds", "signatureKeyId", "signature"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "policyId": {"type": "string", "minLength": 1},
    "maxAttemptsPerTarget": {"type": "integer", "minimum": 0, "maximum": 10},
    "maxExtraTimeSeconds": {"type": "integer", "minimum": 0, "maximum": 900},
    "minimumBatteryReservePercent": {"type": "number", "minimum": 15, "maximum": 100},
    "maximumGsdCmPerPx": {"type": "number", "exclusiveMinimum": 0},
    "minimumOverlapRatio": {"type": "number", "minimum": 0, "maximum": 1},
    "maximumBlurScore": {"type": "number", "minimum": 0},
    "maximumOcclusionRatio": {"type": "number", "minimum": 0, "maximum": 1},
    "maximumGimbalAdjustmentDeg": {"type": "number", "minimum": 0, "maximum": 180},
    "allowedActions": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["RECAPTURE_SAME_POSE", "GIMBAL_ADJUST", "SELECT_PREAUTHORIZED_VIEWPOINT"]}},
    "preauthorizedViewpointIds": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string"}},
    "signatureKeyId": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
