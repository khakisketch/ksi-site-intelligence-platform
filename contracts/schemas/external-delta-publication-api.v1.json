    "DeltaRasterPublicationV1": {
      "additionalProperties": false,
      "description": "Immutable descriptor of derived delta-raster bytes, evidence only.\n\nThe raster is derived from the actual validated delta array\n(``CURRENT_MINUS_BASELINE``), never reconstructed from aggregate metrics.\nThe descriptor carries an opaque protected output id plus the observed\noutput SHA-256 and size; it carries no URL, path, or capability, and it\nasserts no currency, revocation state, or read right. Float width is fixed\nto ``FLOAT64``: a 32-bit float cannot hold metre-scale elevation deltas\nover large grids without metric drift. Lifetime is an explicit\nissued/expires UTC interval; expiry, revocation, scope, and AI-egress are\nchecked by Core before any byte access, not by this descriptor.",
      "properties": {
        "contractVersion": {
          "const": "external-masked-volume-delta-publication.v1",
          "default": "external-masked-volume-delta-publication.v1",
          "title": "Contractversion",
          "type": "string"
        },
        "publicationId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Publicationid",
          "type": "string"
