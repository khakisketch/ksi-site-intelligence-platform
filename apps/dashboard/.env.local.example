# 표준 로컬 진입점은 `npm run dev`다. 이 명령이 loopback local OIDC issuer,
# OIDC 검증 Core, Dashboard를 함께 기동하고 Tailscale Serve로 Tailnet 전용 HTTP
# 3210/9010 포트를 자동 연결한다. Tailscale 없는 순수 localhost 개발은
# `npm run dev:local`을 사용한다.
# 사람은 Bearer 토큰을 입력하지 않고 "조직 계정으로 로그인" → 개발 Identity 계정 선택
# 흐름을 사용한다. OIDC secret과 RSA key는 .dev-data/에만 생성되며 커밋되지 않는다.
#
# Dashboard만 따로 기동해야 하는 특수 조사에는 `npm run dev:dashboard`를 쓰고, 해당
# 프로세스 환경에 Core/OIDC 값을 명시한다. 일반 개발에서 아래 값을 .env.local에
# 복사할 필요는 없다.
CORE_API_BASE_URL=http://127.0.0.1:8012

# Civil comparison creation UI rollout gate. Set to 0 at Dashboard build time to keep existing
# results readable while hiding/disabling only the new comparison creation controls.
NEXT_PUBLIC_KSI_CIVIL_COMPARISON_ENABLED=1
NEXT_PUBLIC_KSI_CHECKPOINT_VALIDATION_ENABLED=0
