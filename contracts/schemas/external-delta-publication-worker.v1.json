    "DeltaPublicationWorkerInputCapabilityV1": {
      "additionalProperties": false,
      "description": "One short-lived server-issued DSM GET bound to the sealed V2 identity.",
      "properties": {
        "role": {
          "enum": [
            "BASELINE_DSM",
            "CURRENT_DSM"
          ],
          "title": "Role",
          "type": "string"
        },
        "artifactId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Artifactid",
          "type": "string"
        },
        "observedSha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Observedsha256",
          "type": "string"
        },
        "observedSizeBytes": {
          "exclusiveMinimum": 0,
          "title": "Observedsizebytes",
          "type": "integer"
        },
        "downloadUrl": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Downloadurl",
          "type": "string"
        },
        "requiredHeaders": {
          "maxProperties": 32,
          "patternProperties": {
            "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$": {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Requiredheaders",
          "type": "object"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        }
      },
      "required": [
        "role",
        "artifactId",
        "observedSha256",
        "observedSizeBytes",
        "downloadUrl",
        "requiredHeaders",
        "expiresAt"
      ],
      "title": "DeltaPublicationWorkerInputCapabilityV1",
      "type": "object"
    },
