[Unit]
Description=KSI external runtime named application socket ACL activation
Requires=ksi-external-runtime-directories.service
After=ksi-external-runtime-directories.service
ConditionPathIsDirectory=/run/ksi-external-runtime/launcher

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/lib/ksi-external-runtime/bin/ksi-external-runtime-socket-acl activate
ExecStartPost=/usr/local/lib/ksi-external-runtime/bin/ksi-external-runtime-socket-acl verify --json
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/ksi-external-runtime/launcher
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
