        "contractVersion": {
          "const": "external-result-review-authority.v1",
          "default": "external-result-review-authority.v1",
          "title": "Contractversion",
          "type": "string"
        },
        "organizationId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Organizationid",
          "type": "string"
        },
        "siteId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Siteid",
          "type": "string"
        },
        "currentWorkOrderId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Currentworkorderid",
          "type": "string"
        },
        "decisionId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Decisionid",
          "type": "string"
        },
        "decisionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Decisiondigest",
          "type": "string"
        },
        "compatibilityMappingDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compatibilitymappingdigest",
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/ExternalVolumeInputBindingV1"
        },
        "current": {
          "$ref": "#/$defs/ExternalVolumeInputBindingV1"
        },
        "evidenceRecordDigests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidencerecorddigests",
          "type": "array"
        },
        "validationPolicyDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Validationpolicydigest",
          "type": "string"
        },
        "zoneSnapshot": {
          "$ref": "#/$defs/ExternalVolumeZoneSnapshotV1"
        },
        "executionPolicy": {
          "$ref": "#/$defs/ExternalRelativeVolumeExecutionPolicyV1"
        },
        "authorizedActorIds": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Authorizedactorids",
          "type": "array"
        },
        "validFrom": {
          "format": "date-time",
          "title": "Validfrom",
          "type": "string"
        },
        "validUntil": {
          "format": "date-time",
          "title": "Validuntil",
          "type": "string"
        },
        "historicalAuthorityDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Historicalauthoritydigest",
          "type": "string"
        },
        "baselineRmseM": {
          "anyOf": [
            {
              "maximum": 1e+300,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baselinermsem"
        },
        "currentRmseM": {
          "anyOf": [
            {
              "maximum": 1e+300,
              "minimum": 0.0,
              "type": "number"
            },
