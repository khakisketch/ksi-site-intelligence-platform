# manifoldctl 설정 템플릿 — 복사해서 scripts/manifold/manifold.env 로 저장한다.
# manifold.env 자체는 gitignore 대상이다(.gitignore 참조) — 비밀은 담지 않지만
# 머신별 설정(경로·이미지 태그 등)이라 커밋 대상이 아니다. IP는 여기서도 직접 쓰지
# 않는다 — DHCP로 바뀔 수 있어 ~/.ssh/config 의 Host 별칭에 두고, 여기서는 그
# 별칭만 참조한다(ADR-KSI-009 §3.5).

# ~/.ssh/config 에 등록한 Host 별칭. 예:
#   Host ksi-manifold
#     HostName 172.30.1.33
#     User dji
#     IdentityFile ~/.ssh/ksi_manifold_ed25519
#     IdentitiesOnly yes
#     ControlMaster auto
#     ControlPath ~/.ssh/cm-%r@%h:%p
#     ControlPersist 10m
MANIFOLD_SSH_HOST=ksi-manifold

# 실기 쪽 작업 루트 — 반드시 /open_app 아래(루트 파티션은 9G뿐, /open_app 은 94G 여유).
MANIFOLD_REMOTE_ROOT=/open_app/ksi-dev

# 빌드에 쓸 컨테이너 이미지 태그(edge/docker/manifold3-build.Dockerfile 로 빌드됨).
MANIFOLD_BUILD_IMAGE=ksi-manifold3-build:latest
