{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/schemas/equipment-support-state.v1.json",
  "title": "EquipmentSupportState",
  "type": "object",
  "required": [
    "classId",
    "state"
  ],
  "properties": {
    "classId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "DATASET_AVAILABLE",
        "BASELINE_DETECTION",
        "FIELD_VALIDATED",
        "GEO_VALIDATED",
        "RISK_VALIDATED",
        "PRODUCTION_SUPPORTED"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelVersion": {
      "type": "string"
    },
    "riskPackVersion": {
      "type": "string"
    }
  }
}
