{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/schemas/defect-candidate.v1.json",
  "title": "DefectCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defectCandidateId",
    "defectType",
    "sourceMediaId",
    "imageSize",
    "geometry",
    "model",
    "confidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "defectCandidateId": {
      "type": "string",
      "minLength": 1
    },
    "defectType": {
      "enum": [
        "CRACK"
      ]
    },
    "sourceMediaId": {
      "type": "string",
      "minLength": 1
    },
    "imageSize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widthPx",
        "heightPx"
      ],
      "properties": {
        "widthPx": {
          "type": "integer",
          "minimum": 1
        },
        "heightPx": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "payload"
      ],
      "properties": {
        "format": {
          "enum": [
            "IMAGE_POLYGON_2D"
          ]
        },
        "payload": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          ]
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "areaPx2": {
          "type": "number",
          "minimum": 0
        },
        "lengthPx": {
          "type": "number",
          "minimum": 0
        },
        "meanWidthPx": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "sourceDigests"
      ],
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigests": {
          "type": "object"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
