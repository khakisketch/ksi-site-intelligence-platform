{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksi.example/contracts/external-analysis-worker.v1.json",
  "title": "External Analysis Worker API V1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "AnalysisExecutionAttemptV2": {
      "additionalProperties": false,
      "description": "A fenced worker ownership interval for exactly one authorization.",
      "properties": {
        "contractVersion": {
          "const": "external-relative-volume-execution-attempt.v2",
          "default": "external-relative-volume-execution-attempt.v2",
          "title": "Contractversion",
          "type": "string"
        },
        "attemptId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Attemptid",
          "type": "string"
        },
        "authorization": {
          "$ref": "#/$defs/AnalysisExecutionAuthorizationV2"
        },
        "authorizationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Authorizationdigest",
          "type": "string"
        },
        "workerInstanceId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Workerinstanceid",
          "type": "string"
        },
        "leaseAcquisitionId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Leaseacquisitionid",
          "type": "string"
        },
        "leaseGeneration": {
          "minimum": 1,
          "title": "Leasegeneration",
          "type": "integer"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "leaseExpiresAt": {
          "format": "date-time",
          "title": "Leaseexpiresat",
          "type": "string"
        },
        "executionAttemptDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executionattemptdigest"
        }
      },
      "required": [
        "attemptId",
        "authorization",
        "authorizationDigest",
        "workerInstanceId",
        "leaseAcquisitionId",
        "leaseGeneration",
        "issuedAt",
        "leaseExpiresAt"
      ],
      "title": "AnalysisExecutionAttemptV2",
      "type": "object"
    },
    "AnalysisExecutionAuthorizationV2": {
      "additionalProperties": false,
      "description": "Core-selected resource and authority snapshot, separate from numeric identity.",
      "properties": {
        "contractVersion": {
          "const": "external-relative-volume-execution-authorization.v2",
          "default": "external-relative-volume-execution-authorization.v2",
          "title": "Contractversion",
          "type": "string"
        },
        "authorizationId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Authorizationid",
          "type": "string"
        },
        "organizationId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Organizationid",
          "type": "string"
        },
        "calculationIdentityDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Calculationidentitydigest",
          "type": "string"
        },
        "admissionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Admissiondigest",
          "type": "string"
        },
        "resourceEnvelope": {
          "$ref": "#/$defs/ResourceEnvelopeV1"
        },
        "resourceEnvelopeDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Resourceenvelopedigest",
          "type": "string"
        },
        "authorizedAt": {
          "format": "date-time",
          "title": "Authorizedat",
          "type": "string"
        },
        "executionAuthorizationDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executionauthorizationdigest"
        }
      },
      "required": [
        "authorizationId",
        "organizationId",
        "calculationIdentityDigest",
        "admissionDigest",
        "resourceEnvelope",
        "resourceEnvelopeDigest",
        "authorizedAt"
      ],
      "title": "AnalysisExecutionAuthorizationV2",
      "type": "object"
    },
    "AnalysisPolicyV2": {
      "additionalProperties": false,
      "description": "The first V2 profile's mathematical identity, without an execution result.",
      "properties": {
        "contractVersion": {
          "const": "external-relative-volume-analysis-policy.v2",
          "default": "external-relative-volume-analysis-policy.v2",
          "title": "Contractversion",
          "type": "string"
        },
        "policyId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policyid",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "profileId": {
          "const": "KSI-GIS-RELATIVE-VOLUME-V2",
          "title": "Profileid",
          "type": "string"
        },
        "profileDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profiledigest",
          "type": "string"
        },
        "algorithmDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Algorithmdigest",
          "type": "string"
        },
        "configDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Configdigest",
          "type": "string"
        },
        "baselineGridRule": {
          "const": "BASELINE_NATIVE_NORTH_UP_AFFINE_V1",
          "title": "Baselinegridrule",
          "type": "string"
        },
        "currentElevationResampling": {
          "const": "BILINEAR",
          "title": "Currentelevationresampling",
          "type": "string"
        },
        "currentMaskResampling": {
          "const": "NEAREST",
          "title": "Currentmaskresampling",
          "type": "string"
        },
        "workAreaRasterization": {
          "const": "CELL_CENTER",
          "title": "Workarearasterization",
          "type": "string"
        },
        "minimumCommonValidFraction": {
          "title": "Minimumcommonvalidfraction",
          "type": "number"
        },
        "thresholdM": {
          "title": "Thresholdm",
          "type": "number"
        },
        "cellAreaRule": {
          "const": "ABSOLUTE_AFFINE_DETERMINANT",
          "title": "Cellarearule",
          "type": "string"
        },
        "deltaRule": {
          "const": "CURRENT_MINUS_BASELINE",
          "title": "Deltarule",
          "type": "string"
        },
        "uncertaintyMethod": {
          "const": "NONE_UNCERTAINTY_M3_NULL_V1",
          "title": "Uncertaintymethod",
          "type": "string"
        },
        "policyDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policydigest"
        }
      },
      "required": [
        "policyId",
        "version",
        "profileId",
        "profileDigest",
        "algorithmDigest",
        "configDigest",
        "baselineGridRule",
        "currentElevationResampling",
        "currentMaskResampling",
        "workAreaRasterization",
        "minimumCommonValidFraction",
        "thresholdM",
        "cellAreaRule",
        "deltaRule",
        "uncertaintyMethod"
      ],
      "title": "AnalysisPolicyV2",
      "type": "object"
    },
    "AnalysisWorkerFailureRequestV1": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "$ref": "#/$defs/RelativeVolumeCalculationFailureV2"
        }
      },
      "required": [
        "failure"
      ],
      "title": "AnalysisWorkerFailureRequestV1",
      "type": "object"
    },
    "AnalysisWorkerInputCapabilityV1": {
      "additionalProperties": false,
      "description": "One short-lived URL bound to one immutable DSM identity.",
      "properties": {
        "role": {
          "enum": [
            "BASELINE_DSM",
            "CURRENT_DSM"
          ],
          "title": "Role",
          "type": "string"
        },
        "artifactId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Artifactid",
          "type": "string"
        },
        "observedSha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Observedsha256",
          "type": "string"
        },
        "observedSizeBytes": {
          "exclusiveMinimum": 0,
          "title": "Observedsizebytes",
          "type": "integer"
        },
        "downloadUrl": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Downloadurl",
          "type": "string"
        },
        "requiredHeaders": {
          "maxProperties": 32,
          "patternProperties": {
            "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$": {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Requiredheaders",
          "type": "object"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        }
      },
      "required": [
        "role",
        "artifactId",
        "observedSha256",
        "observedSizeBytes",
        "downloadUrl",
        "requiredHeaders",
        "expiresAt"
      ],
      "title": "AnalysisWorkerInputCapabilityV1",
      "type": "object"
    },
    "AnalysisWorkerInputResponseV1": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "#/$defs/AnalysisWorkerInputV1"
        }
      },
      "required": [
        "input"
      ],
      "title": "AnalysisWorkerInputResponseV1",
      "type": "object"
    },
    "AnalysisWorkerInputV1": {
      "additionalProperties": false,
      "description": "Exact attempt, identity, and ordered bounded inputs for one measurement.",
      "properties": {
        "analysisId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Analysisid",
          "type": "string"
        },
        "calculationRequestId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Calculationrequestid",
          "type": "string"
        },
        "attempt": {
          "$ref": "#/$defs/AnalysisExecutionAttemptV2"
        },
        "calculationIdentity": {
          "$ref": "#/$defs/CalculationIdentityV2"
        },
        "inputs": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/AnalysisWorkerInputCapabilityV1"
            },
            {
              "$ref": "#/$defs/AnalysisWorkerInputCapabilityV1"
            }
          ],
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "analysisId",
        "calculationRequestId",
        "attempt",
        "calculationIdentity",
        "inputs"
      ],
      "title": "AnalysisWorkerInputV1",
      "type": "object"
    },
    "AnalysisWorkerLeaseRequestV1": {
      "additionalProperties": false,
      "properties": {
        "workerInstanceId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Workerinstanceid",
          "type": "string"
        },
        "leaseAcquisitionId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Leaseacquisitionid",
          "type": "string"
        }
      },
      "required": [
        "workerInstanceId",
        "leaseAcquisitionId"
      ],
      "title": "AnalysisWorkerLeaseRequestV1",
      "type": "object"
    },
    "AnalysisWorkerLeaseViewV1": {
      "additionalProperties": false,
      "properties": {
        "analysisId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Analysisid",
          "type": "string"
        },
        "calculationRequestId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Calculationrequestid",
          "type": "string"
        },
        "attempt": {
          "$ref": "#/$defs/AnalysisExecutionAttemptV2"
        }
      },
      "required": [
        "analysisId",
        "calculationRequestId",
        "attempt"
      ],
      "title": "AnalysisWorkerLeaseViewV1",
      "type": "object"
    },
    "AnalysisWorkerMutationViewV1": {
      "additionalProperties": false,
      "properties": {
        "analysisId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Analysisid",
          "type": "string"
        },
        "calculationRequestId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Calculationrequestid",
          "type": "string"
        },
        "executionState": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "FAILED"
          ],
          "title": "Executionstate",
          "type": "string"
        },
        "attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisExecutionAttemptV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "analysisId",
        "calculationRequestId",
        "executionState"
      ],
      "title": "AnalysisWorkerMutationViewV1",
      "type": "object"
    },
    "AnalysisWorkerPendingItemV1": {
      "additionalProperties": false,
      "properties": {
        "analysisId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Analysisid",
          "type": "string"
        },
        "calculationRequestId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Calculationrequestid",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        }
      },
      "required": [
        "analysisId",
        "calculationRequestId",
        "issuedAt"
      ],
      "title": "AnalysisWorkerPendingItemV1",
      "type": "object"
    },
    "AnalysisWorkerPendingListV1": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AnalysisWorkerPendingItemV1"
          },
          "maxItems": 200,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "AnalysisWorkerPendingListV1",
      "type": "object"
    },
    "AnalysisWorkerRenewRequestV1": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "$ref": "#/$defs/AnalysisExecutionAttemptV2"
        }
      },
      "required": [
        "attempt"
      ],
      "title": "AnalysisWorkerRenewRequestV1",
      "type": "object"
    },
    "AnalysisWorkerReportRequestV1": {
      "additionalProperties": false,
      "properties": {
        "report": {
          "$ref": "#/$defs/RelativeVolumeCalculationReportV2"
        }
      },
      "required": [
        "report"
      ],
      "title": "AnalysisWorkerReportRequestV1",
      "type": "object"
    },
    "CalculationIdentityV2": {
      "additionalProperties": false,
