# Independently released, contained external reconstruction inspector image.
# The rootless launcher supplies the signed UID/GID and hardened runtime policy;
# this image provides only the locked code and the fixed stdin/stdout entrypoint.
FROM python:3.12.15-slim@sha256:29113dcae7aad06daa8e95260fa09f27d62be33b9687ea3774f771d601a02256 AS runtime-builder

COPY --from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages packages
COPY services services
RUN uv sync --locked --package ksi-processing-controller --no-dev

FROM python:3.12.15-slim@sha256:29113dcae7aad06daa8e95260fa09f27d62be33b9687ea3774f771d601a02256

# Preserve the approved OS security fixes alongside the patched Python base.
# APT still verifies repository signatures; only the archived Valid-Until is disabled.
RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/20261003T000000Z|' \
      -e 's|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/20261003T000000Z|' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update -qq \
    && apt-get install -y -qq --no-install-recommends \
      gzip=1.13-1+deb13u1 \
      libc-bin=2.41-12+deb13u4 \
      libc6=2.41-12+deb13u4 \
      libexpat1=2.8.3-1~deb13u1 \
      libpcre2-8-0=10.46-1~deb13u3 \
      libsqlite3-0=3.46.1-7+deb13u2 \
      openssl=3.5.7-1~deb13u3 \
      libssl3t64=3.5.7-1~deb13u3 \
      openssl-provider-legacy=3.5.7-1~deb13u3 \
      perl-base=5.40.1-6+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=runtime-builder /app/.venv /app/.venv
COPY --from=runtime-builder /app/packages/change-detection /app/packages/change-detection
COPY --from=runtime-builder /app/packages/domain /app/packages/domain
COPY --from=runtime-builder /app/packages/event-contracts /app/packages/event-contracts
COPY --from=runtime-builder /app/packages/geo-core /app/packages/geo-core
COPY --from=runtime-builder /app/packages/geo-spatial /app/packages/geo-spatial
COPY --from=runtime-builder /app/packages/perception /app/packages/perception
COPY --from=runtime-builder /app/services/processing-controller /app/services/processing-controller

# This default identity is intentionally distinct from the measurement image.
# Production execution overrides it only with the signed manifest UID/GID and
# re-proves the resulting Docker configuration before protocol execution.
RUN useradd --create-home --uid 10003 ksi-inspector-image
USER ksi-inspector-image

CMD ["/app/.venv/bin/ksi-external-inspector-entrypoint"]
