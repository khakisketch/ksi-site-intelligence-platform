{
  "$defs": {
    "DecisionVerdict": {
      "enum": [
        "ELIGIBLE",
        "RESTRICTED",
        "BLOCKED"
      ],
      "title": "DecisionVerdict",
      "type": "string"
    },
    "ExternalPairUseDecisionV1": {
      "additionalProperties": false,
      "description": "Core's immutable pair decision; Core resolves referenced receipt provenance separately.",
      "properties": {
        "contractVersion": {
          "const": "external-pair-use-decision.v1",
          "default": "external-pair-use-decision.v1",
          "title": "Contractversion",
          "type": "string"
        },
        "decisionId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Decisionid",
          "type": "string"
        },
        "baselineSubject": {
          "$ref": "#/$defs/SealedExternalSubjectV1"
        },
        "baselineSubjectDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Baselinesubjectdigest",
          "type": "string"
        },
        "currentSubject": {
          "$ref": "#/$defs/SealedExternalSubjectV1"
        },
        "currentSubjectDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Currentsubjectdigest",
          "type": "string"
        },
        "use": {
          "enum": [
            "VISUAL_COMPARISON",
            "RELATIVE_VOLUME"
          ],
          "title": "Use",
          "type": "string"
        },
        "policyDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policydigest"
        },
        "baselineInspectionReportDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baselineinspectionreportdigest"
        },
        "currentInspectionReportDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currentinspectionreportdigest"
        },
        "baselineSanitizedDisplayReceiptDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baselinesanitizeddisplayreceiptdigest"
        },
        "currentSanitizedDisplayReceiptDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currentsanitizeddisplayreceiptdigest"
        },
        "evidenceRecordDigests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidencerecorddigests",
          "type": "array"
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/$defs/SealedZoneReferenceV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compatibilityMappingDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compatibilitymappingdigest"
        },
        "verdict": {
          "$ref": "#/$defs/DecisionVerdict"
        },
        "reasons": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "remediations": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Remediations",
          "type": "array"
        },
        "decidedAt": {
          "format": "date-time",
          "title": "Decidedat",
          "type": "string"
        },
        "decisionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "decisionId",
        "baselineSubject",
        "baselineSubjectDigest",
        "currentSubject",
        "currentSubjectDigest",
        "use",
        "evidenceRecordDigests",
        "verdict",
        "reasons",
        "remediations",
        "decidedAt",
        "decisionDigest"
      ],
      "title": "ExternalPairUseDecisionV1",
      "type": "object"
    },
    "ExternalRelativeVolumeExecutionPolicyV1": {
      "additionalProperties": false,
      "description": "Versioned execution limits; authority is always supplied, never defaulted.",
      "properties": {
        "contractVersion": {
          "const": "external-relative-volume-execution-policy.v1",
          "default": "external-relative-volume-execution-policy.v1",
          "title": "Contractversion",
          "type": "string"
        },
        "policyId": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policyid",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "algorithmBuildDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Algorithmbuilddigest",
          "type": "string"
        },
        "configDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Configdigest",
          "type": "string"
        },
        "thresholdM": {
          "maximum": 1e+300,
          "minimum": 0.0,
          "title": "Thresholdm",
          "type": "number"
        },
        "minimumCommonValidFraction": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Minimumcommonvalidfraction",
          "type": "number"
        },
        "uncertaintyMethod": {
          "const": "INDEPENDENT_EPOCH_RSS_AREA_BOUND_V1",
          "title": "Uncertaintymethod",
          "type": "string"
        },
        "resourceEnvelopeDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Resourceenvelopedigest",
          "type": "string"
        },
        "authorityRecordDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Authorityrecorddigest",
          "type": "string"
        },
        "syntheticTestOnly": {
          "title": "Synthetictestonly",
          "type": "boolean"
        },
        "policyDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "policyId",
        "version",
        "algorithmBuildDigest",
        "configDigest",
        "thresholdM",
        "minimumCommonValidFraction",
        "uncertaintyMethod",
        "resourceEnvelopeDigest",
        "authorityRecordDigest",
        "syntheticTestOnly",
        "policyDigest"
      ],
      "title": "ExternalRelativeVolumeExecutionPolicyV1",
      "type": "object"
    },
    "ExternalRelativeVolumeMeasurementPayloadV1": {
      "additionalProperties": false,
      "description": "Deterministic observed measurement content, excluding worker and fence facts.",
      "properties": {
        "factClass": {
          "const": "OBSERVED",
          "default": "OBSERVED",
          "title": "Factclass",
          "type": "string"
        },
        "requestDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Requestdigest",
          "type": "string"
        },
        "decisionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Decisiondigest",
          "type": "string"
        },
        "baselineDsmDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Baselinedsmdigest",
          "type": "string"
        },
        "currentDsmDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Currentdsmdigest",
          "type": "string"
        },
        "zoneSnapshotDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Zonesnapshotdigest",
          "type": "string"
        },
        "executionPolicyDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Executionpolicydigest",
          "type": "string"
        },
        "algorithmBuildDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Algorithmbuilddigest",
          "type": "string"
        },
        "configDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Configdigest",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/ExternalVolumeMetricsV1"
        }
      },
      "required": [
        "requestDigest",
        "decisionDigest",
        "baselineDsmDigest",
        "currentDsmDigest",
        "zoneSnapshotDigest",
        "executionPolicyDigest",
        "algorithmBuildDigest",
        "configDigest",
        "metrics"
      ],
      "title": "ExternalRelativeVolumeMeasurementPayloadV1",
      "type": "object"
    },
